---
// Marco de la demo del hero de las páginas aurora: mockups/Window (variante hero) con su CSS. La demo va en el slot.
import './window.css';
import Window from './Window.astro';
interface Props { id?: string; label: string; class?: string }
const { id, label, class: cls } = Astro.props;
---
<Window variant="hero" class={cls} id={id} label={label}><slot /></Window>
