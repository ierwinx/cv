---
// Marco de la demo del hero. La demo de cada app va en el slot.
import './window.css';
interface Props { id?: string; label: string; class?: string }
const { id, label, class: cls } = Astro.props;
---
<div class="stage reveal">
  <div class:list={['window', cls]} id={id} data-scroll-tilt aria-label={label} role="img"><slot /></div>
</div>
