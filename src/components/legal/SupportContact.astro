---
// Bloque «Escríbeme» de las páginas de soporte con LegalShell: qué incluir en el reporte y el formulario (#contacto).
import ContactForm from '../ui/ContactForm.astro';

interface Props {
  origen: string;        // slug de la app: así llega a Firestore
  hint: string;          // «Para reportar un problema, incluye…»
  placeholder: string;
}
const { origen, hint, placeholder } = Astro.props;
---
<div class="lg-contact reveal" id="contacto">
  <h2>Escríbeme</h2>
  <p>{hint}</p>
  <ContactForm origen={origen} placeholder={placeholder} />
</div>
