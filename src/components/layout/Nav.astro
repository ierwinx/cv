---
// Barra superior de todas las páginas de app (diseño de Super Pets): píldora de cristal que se encoge al
// hacer scroll, ícono que gira al pasar el cursor, enlace activo y menú en móvil. La anima core/nav.ts.
// Colores con tokens: el fondo sale de --panel-rgb y la sombra del ícono de --a1.
import '../../styles/tokens.css';
import './nav.css';
import DownloadButton from '../ui/DownloadButton.astro';
import Button from '../ui/Button.astro';
import type { App } from '../../lib/apps';

interface Props {
  app: App;
  links: [href: string, label: string][];
  home?: string;        // a dónde lleva la marca: «#top» en la portada, «index.html» en las demás
}
const { app, links, home = '#top' } = Astro.props;
const current = Astro.url.pathname.split('/').pop();
---
<nav class="ui-nav" data-ui-nav aria-label={app.name}>
  <div class="ui-nav-inner">
    <a class="ui-nav-logo" href={home}><slot name="logo"><img src={app.home?.logo ?? app.icon} alt="" width="36" height="36"></slot>{app.name}</a>
    <ul class="ui-nav-links" id={`nav-${app.slug}`}>
      {links.map(([href, label]) => <li><a href={href} class={href === current ? 'is-active' : undefined}>{label}</a></li>)}
    </ul>
    <div class="ui-nav-cta">
      <slot name="cta">
        {app.release
          ? <DownloadButton app={app} size="sm">Descargar</DownloadButton>
          : app.install && <Button href={app.install} size="sm" external>Descargar</Button>}
      </slot>
    </div>
    <button class="ui-nav-menu" type="button" aria-label="Menú" aria-expanded="false" aria-controls={`nav-${app.slug}`}><span></span><span></span></button>
  </div>
</nav>
