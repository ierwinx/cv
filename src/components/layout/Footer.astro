---
// Pie de las páginas de app: siempre enlaza a la home de ierwinx.
import './footer.css';
import type { App } from '../../lib/apps';

interface Props { app: App; note: string; tagline: string }
const { app, note, tagline } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap">
    <span>© {new Date().getFullYear()} {app.name} · por <a href="/">ierwinx</a>. {note}</span>
    <span>{tagline} · <a href={`/contacto/?app=${app.slug}`}>¿Problemas? Escríbeme</a></span>
  </div>
</footer>
