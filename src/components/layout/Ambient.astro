---
// Fondo de las páginas de app: estrellas (opcional), aurora con los colores del tema,
// símbolos de la app flotando, grano, foco del cursor, barra de progreso y lienzo para el confeti.
import GlyphField from '../ui/GlyphField.astro';
import type { App } from '../../lib/apps';

interface Props { app: App; stars?: boolean }
const { app, stars = false } = Astro.props;
---
{stars && <canvas id="stars" aria-hidden="true"></canvas>}
<div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
<GlyphField app={app} />
<div class="spot"></div>
<div class="grain"></div>
<div id="progress"></div>
<canvas id="confetti" aria-hidden="true"></canvas>
