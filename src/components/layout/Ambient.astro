---
// Fondo de las páginas de app: estrellas (opcional), aurora con los colores del tema,
// grano, foco del cursor, barra de progreso y lienzo para el confeti.
interface Props { stars?: boolean }
const { stars = false } = Astro.props;
---
{stars && <canvas id="stars" aria-hidden="true"></canvas>}
<div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
<div class="spot"></div>
<div class="grain"></div>
<div id="progress"></div>
<canvas id="confetti" aria-hidden="true"></canvas>
