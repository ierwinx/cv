---
import './steps.css';
// El texto admite HTML (p. ej. .kbd).
interface Props { items: [title: string, html: string][] }
const { items } = Astro.props;
---
<div class="steps">
  {items.map(([title, html], i) => (
    <div class="step tilt reveal"><div class="n">{String(i + 1).padStart(2, '0')}</div><h3>{title}</h3><p set:html={html} /></div>
  ))}
</div>
