---
// Llamada final con anillos animados: título, texto, botón (slot) y requisitos.
import './section.css';
import './download.css';
interface Props { eyebrow: string; title: string; accent: string; sub: string; requirements: string[] }
const { eyebrow, title, accent, sub, requirements } = Astro.props;
---
<section id="descargar" class="section flush">
  <div class="wrap">
    <div class="download reveal">
      <div class="rings"><i></i><i></i><i></i></div>
      <div class="eyebrow">// {eyebrow}</div>
      <h2>{title}<br><span class="grad-text">{accent}</span></h2>
      <p class="sub">{sub}</p>
      <div class="cta"><slot /></div>
      <div class="req">{requirements.map((r) => <span>{r}</span>)}</div>
    </div>
  </div>
</section>
