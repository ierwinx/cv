---
// Preguntas frecuentes (las de iLegato). La respuesta acepta HTML (enlaces, <b>, varios <p>).
import '../../styles/tokens.css';
import './faq.css';
interface Props { items: [question: string, answer: string][] }
const { items } = Astro.props;
---
<div class="ui-faq">
  {items.map(([q, a]) => <details class="reveal"><summary>{q}</summary><div class="ui-faq-answer" set:html={a} /></details>)}
</div>
