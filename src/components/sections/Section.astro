---
// Sección con encabezado estándar: eyebrow, h2 con remate en gradiente y subtítulo opcional.
// `flush` quita el espacio superior cuando sigue a otra sección.
import './section.css';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  accent: string;
  sub?: string;
  center?: boolean;
  flush?: boolean;
}
const { id, eyebrow, title, accent, sub, center = false, flush = false } = Astro.props;
---
<section id={id} class:list={['section', { flush }]}>
  <div class:list={['wrap', { center }]}>
    <div class="eyebrow reveal">// {eyebrow}</div>
    <h2 class="reveal">{title}<br><span class="grad-text">{accent}</span></h2>
    {sub && <p class="sub reveal">{sub}</p>}
    <slot />
  </div>
</section>
