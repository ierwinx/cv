---
// Lista numerada de principios o decisiones técnicas. El texto admite HTML (p. ej. .kbd).
import './principles.css';
interface Props { items: [title: string, html: string][] }
const { items } = Astro.props;
---
<div class="principles">
  {items.map(([title, html], i) => (
    <div class="pr reveal"><span class="k">{String(i + 1).padStart(2, '0')}</span><div><h4>{title}</h4><p set:html={html} /></div></div>
  ))}
</div>
