---
// Cinta infinita de palabras clave (se duplica para el bucle sin cortes).
import './marquee.css';
interface Props { items: string[] }
const { items } = Astro.props;
---
<div class="marquee" aria-hidden="true">
  <div class="mtrack">{[...items, ...items].map((i) => <span>{i}</span>)}</div>
</div>
