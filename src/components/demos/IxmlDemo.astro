---
// Demo del hero de iXML: modo dividido con árbol y código; escribe una abreviatura y la expande con ⇥.
import AppWindow from '../mockups/AppWindow.astro';
import './ixml.css';
---
<AppWindow class="ix-demo" label="Así se ve iXML">
  <div class="titlebar">
    <span class="dot" style="background:#ff5f57"></span><span class="dot" style="background:#febc2e"></span><span class="dot" style="background:#28c840"></span>
    <span style="margin-left:10px">biblioteca.xml — Editado</span>
    <span class="seg"><i>Texto</i><i>Visual</i><i class="on">Dividido</i></span>
  </div>
  <div class="panes">
    <div class="tree" data-tree></div>
    <div class="code xml-code" data-code></div>
  </div>
  <span class="keycap" data-keycap>⇥ Tab</span>
</AppWindow>

<script>
  import { mount } from '../../scripts/demos/ixml';
  document.querySelectorAll<HTMLElement>('.ix-demo').forEach(mount);
</script>
