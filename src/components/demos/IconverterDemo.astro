---
// Ventana de iConverter convirtiendo un álbum (la anima scripts/demos/iconverter.ts; la monta el script de cada página).
import './iconverter.css';
---
<div class="ic-mac" data-iconverter role="img" aria-label="Simulación de la ventana de iConverter convirtiendo un álbum">
  <div class="ic-bar"><i></i><i></i><i></i></div>
  <div class="ic-body">
    <div class="ic-head">
      <div class="ic-logo"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"><path d="M3 12h1M7 8v8M11 5v14M15 9v6M19 7v10M22 12h-1"/></svg></div>
      <div><b>FLAC → AAC</b><small>Convierte tu música lossless a M4A</small></div>
    </div>
    <div class="ic-card">
      <div class="ic-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg></div>
      <div class="ic-txt"><b>Ubicación <span class="ic-badge">12 lossless</span><span class="ic-badge ic-badge--b">2 lossy</span></b><small>~/Música/Nova Lumen/Horizonte Eléctrico</small></div>
      <span class="ic-btn">Elegir…</span>
    </div>
    <div class="ic-card">
      <div class="ic-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></div>
      <div class="ic-txt"><b>Carpeta salida</b><small>~/Music/Media/Automatically Add to Music</small></div>
      <span class="ic-btn">Cambiar…</span>
    </div>
    <div class="ic-card">
      <div class="ic-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 12l4-4"/></svg></div>
      <div class="ic-txt"><b>BitRate</b><small data-ic-bit>320 kbps</small></div>
      <div class="ic-seg" data-ic-seg><span>128</span><span>192</span><span>256</span><span class="on">320</span></div>
    </div>
    <div class="ic-prog">
      <div class="ic-prog-top"><span data-ic-state>Listo para convertir</span><span data-ic-count>0 / 14</span></div>
      <div class="ic-track"><i data-ic-fill></i></div>
    </div>
    <div class="ic-go" data-ic-go><svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><path d="M6 4l14 8-14 8z"/></svg>Iniciar</div>
    <div class="ic-log" data-ic-log></div>
  </div>
</div>
