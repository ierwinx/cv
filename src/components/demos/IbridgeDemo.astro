---
// Demo del hero de iBridge: copia de la interfaz real. La anima src/scripts/demos/ibridge.ts.
import AppWindow from '../mockups/AppWindow.astro';
import './ibridge.css';
---
<AppWindow class="ib-demo" label="Así se ve iBridge">
  <div class="ibw">
    <aside class="sb">
      <div class="lights"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span class="tog"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M9 5v14"/></svg></span></div>
      <div class="devhead"><span class="ph"></span><div><b id="dName">Galaxy de Papá</b><div class="cap"><i id="dCap"></i></div><small id="dFree">218,15 GB libres</small></div></div>
      <h6 id="hPlaces">En el teléfono</h6>
      <div id="places"></div>
      <h6>Otros dispositivos<em>Clic para abrir · arrastra aquí para enviar</em></h6>
      <div id="others"></div>
      <div class="it"><svg viewBox="0 0 24 24" style="color:#ff7b8c"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg>Todos los dispositivos</div>
      <h6>En tu Mac</h6>
      <div class="it mac"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="13" rx="2"/><path d="M3 14h18"/></svg>Escritorio</div>
      <div class="it mac"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v9M8 12l4 4 4-4"/></svg>Descargas</div>
      <div class="it mac"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="M21 16l-5-5-8 8"/></svg>Imágenes</div>
    </aside>
    <div class="main">
      <div class="tb">
        <div class="nav2"><span><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></span><span class="off"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></span></div>
        <div class="ttl"><b id="tDev">Galaxy de Papá</b><small id="tPlace">Música</small></div>
        <div class="tools"><svg viewBox="0 0 24 24"><path d="M5 5h2M11 5h2M17 5h2M5 12h2M11 12h2M17 12h2M5 19h2M11 19h2M17 19h2"/></svg><span class="slider"></span><svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/></svg><span class="nf" id="newFolder" style="display:flex;align-items:center;gap:6px"><svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><path d="M15 10v6M12 13h6"/></svg>Nueva carpeta</span></div>
        <div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/></svg>Buscar aquí</div>
      </div>
      <div class="crumbbar"><span class="crumb" id="cDev">Galaxy de Papá</span><span class="sep">›</span><span class="crumb here" id="cPlace">Música</span><span class="viewby" id="viewBy" hidden>Ver por: <span><i class="on">Meses</i><i>Carpetas</i></span></span></div>
      <div class="files" id="files"></div>
      <div class="status" id="status">
        <div class="txt"><b id="sMain">105 elementos</b><small id="sHint">Toca algo para elegirlo. Para elegir varios, mantén ⌘ y toca.</small></div>
        <span class="bt go" id="btnCopy"><svg viewBox="0 0 24 24"><path d="M4 15v4h16v-4"/><path d="M12 4v11M8 11l4 4 4-4"/></svg>Copiar a mi Mac</span>
        <span class="bt"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M13 9l3 3-3 3"/></svg>Enviar a…</span>
        <span class="bt"><svg viewBox="0 0 24 24"><path d="M4 20l4-1 11-11-3-3L5 16z"/></svg>Renombrar</span>
        <span class="bt del"><svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>Borrar</span>
      </div>
    </div>
  </div>
  <div class="transfer" id="transfer" aria-hidden="true">
    <b id="tTitle">Copiando a tu Mac</b>
    <div class="track"><i id="tBar"></i></div>
    <small id="tLeft">Quedan unos segundos</small>
  </div>
  <svg class="cursor" id="cursor" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3l14 8-6 1.5L10 19z" fill="#fff" stroke="#000" stroke-width="1.2" stroke-linejoin="round"/></svg>
</AppWindow>

<script>
  import { mount } from '../../scripts/demos/ibridge';
  document.querySelectorAll<HTMLElement>('.ib-demo').forEach(mount);
</script>
