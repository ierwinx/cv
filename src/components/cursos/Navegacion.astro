---
// Tarjetas «Anterior» y «Siguiente» al pie de una lección o un módulo. Las flechas del teclado las siguen
// (scripts/pages/curso.ts).
interface Enlace { url: string; titulo: string }
interface Props {
  anterior?: Enlace;
  siguiente?: Enlace;
  etiqueta?: string;
}
const { anterior, siguiente, etiqueta = 'Lección anterior y siguiente' } = Astro.props;
---
{(anterior || siguiente) && (
  <nav class="navegacion-lecciones" aria-label={etiqueta}>
    {anterior && (
      <a class="tarjeta-navegacion anterior" href={anterior.url}>
        <span class="direccion-navegacion">Anterior</span><span class="titulo-navegacion">{anterior.titulo}</span>
      </a>
    )}
    {siguiente && (
      <a class="tarjeta-navegacion siguiente" href={siguiente.url}>
        <span class="direccion-navegacion">Siguiente</span><span class="titulo-navegacion">{siguiente.titulo}</span>
      </a>
    )}
  </nav>
)}
