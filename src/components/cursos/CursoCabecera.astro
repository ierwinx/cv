---
// Cabecera de vidrio de un curso: menú (móvil), marca, buscador y tema claro/oscuro.
// El buscador carga su índice (/cursos/<curso>/buscar.json) la primera vez que se usa: scripts/pages/curso.ts.
import type { Curso } from '../../lib/cursos';

interface Props { curso: Curso }
const { curso } = Astro.props;
const { icono, nombre } = curso.entrada.data;
---
<header class="cabecera">
  <button class="boton-icono boton-menu" type="button" aria-label="Abrir el menú de lecciones" aria-expanded="false">
    <span class="hamburguesa"></span>
  </button>
  <a class="marca" href={curso.url}>
    <span class="marca-icono">{icono}</span>
    <span class="marca-texto">{nombre}</span>
  </a>
  <div class="caja-busqueda">
    <input type="search" id="campo-busqueda" placeholder="Buscar en el curso..." autocomplete="off"
           aria-label="Buscar en el curso" aria-controls="resultados-busqueda">
    <kbd class="atajo-busqueda">/</kbd>
    <div id="resultados-busqueda" class="resultados-busqueda" hidden></div>
  </div>
  <button class="boton-icono boton-tema" type="button" aria-label="Cambiar entre tema claro y oscuro">
    <span class="icono-claro">&#9788;</span><span class="icono-oscuro">&#9789;</span>
  </button>
</header>
