---
// Estructura común de todas las páginas de Super Pets: fondo, nav, footer, estilos y script.
// La portada usa variant="home" (anclas, botón de descarga, footer completo); las legales, "legal".
import AppPage from '../../layouts/AppPage.astro';
import Nav from '../layout/Nav.astro';
import Button from '../ui/Button.astro';
import GlyphField from '../ui/GlyphField.astro';
import Footer from '../layout/Footer.astro';
import { getApp } from '../../lib/apps';
import '../../styles/pages/superpets.css';

interface Props {
  variant: 'home' | 'legal';
  title?: string;
  description?: string;
  deleteAccountLink?: boolean;   // enlace «Eliminar cuenta» en el footer
}
const { variant, title, description, deleteAccountLink = false } = Astro.props;
const app = getApp('superpets');
const home = variant === 'home';
const links: [string, string][] = home
  ? [['#features', 'Funciones'], ['#tour', 'Recorrido'], ['#screenshots', 'Capturas'], ['support.html', 'Soporte'], ['privacy.html', 'Privacidad']]
  : [['index.html', 'Inicio'], ['support.html', 'Soporte'], ['privacy.html', 'Privacidad'], ['terms.html', 'Términos']];
---
<AppPage slug="superpets" title={title} description={description} bodyClass={home ? 'home' : undefined}>
<div class="bg-aurora" aria-hidden="true"><span></span><span></span><span></span></div>
<div class="bg-grain" aria-hidden="true"></div>
<GlyphField app={app} />
<div class="scroll-progress" aria-hidden="true"></div>

<Nav app={app} links={links} home="index.html">
    <img slot="logo" src="img/app-icon.png" alt="" width="36" height="36">
    {home ? <Button slot="cta" href={app.install} size="sm" external>Descargar</Button> : <Fragment slot="cta" />}
</Nav>

<slot />

<Footer app={app} giant={home} extra={deleteAccountLink ? [['delete-account.html', 'Eliminar cuenta']] : []}
        tagline="La app para dueños responsables que quieren lo mejor para sus mascotas. Gestiona salud, vacunas y cuidados desde un solo lugar." />

<script>import '../../scripts/pages/superpets';</script>
</AppPage>
