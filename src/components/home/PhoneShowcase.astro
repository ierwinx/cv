---
// Teléfono con capturas que rotan (scripts/pages/home.ts) y tarjetas flotantes. Super Pets e iLegato.
interface Props { shots: [src: string, alt: string][]; cards: [emoji: string, title: string, sub: string][]; background?: string }
const { shots, cards, background } = Astro.props;
---
<div class="pets-visual">
  <div class="phone">
    <div class="phone-screen" style={background && `background:${background}`}>
      {shots.map(([src, alt], i) => <img src={src} alt={alt} class={i === 0 ? 'on' : undefined} loading="lazy">)}
    </div>
    <div class="phone-island"></div>
  </div>
  {cards.map(([emoji, title, sub], i) => <div class={`float-card fc-${i + 1}`}><span>{emoji}</span><div><b>{title}</b><small>{sub}</small></div></div>)}
</div>
