---
// iCSV recorriendo 10 millones de filas (scripts/home/csv.ts; lo monta scripts/pages/home.ts).
import Window from './Window.astro';
---
<Window class="window--csv" title="ventas_2026.csv — 10 000 000 filas">
  <div class="data-toolbar">
    <span class="search">⌘F Buscar</span>
    <span class="tag">UTF-8 · coma</span>
    <span class="speed">⚡ 1,2 GB/s</span>
  </div>
  <div class="csv-grid" id="csvGrid"></div>
  <div class="data-foot"><span id="csvFoot">Fila 1 de 10 000 000</span><span class="ok">✓ 0 bytes alterados</span></div>
</Window>
