---
// Ícono de una app en la home (apps.json → home.logo; Super Pets es redondo).
import type { App } from '../../lib/apps';
interface Props { app: App; alt?: string; class?: string }
const { app, alt = '', class: cls } = Astro.props;
---
<img class:list={[cls, { round: app.home?.round }]} src={app.home?.logo} alt={alt}>
