---
// iSpecter: espectrograma en vivo con veredicto (scripts/home/spectrogram.ts; lo monta scripts/pages/home.ts).
import Window from './Window.astro';
---
<Window class="window--spec" title="Pista 07 — Master Hi-Res.flac">
  <div class="spec-wrap">
    <canvas id="spectrogram" width="640" height="360"></canvas>
    <div class="spec-axis">{['22k', '16.5k', '11k', '5.5k', '0'].map((f) => <span>{f}</span>)}</div>
    <div class="spec-cutoff" data-cutoff><span>corte 16.0 kHz</span></div>
  </div>
  <div class="spec-verdict" data-verdict><i></i><span>Analizando…</span></div>
</Window>
