---
// iXML en modo dividido, con expansión de abreviaturas (scripts/home/xml.ts; lo monta scripts/pages/home.ts).
import Window from './Window.astro';
---
<Window class="window--xml">
  <Fragment slot="title">biblioteca.xml — <em id="xmlState">Abierto</em></Fragment>
  <div class="data-toolbar">
    <span class="seg" id="xmlSeg"><b>Texto</b><b>Visual</b><b class="on">Dividido</b></span>
    <span class="valid">● XML válido</span>
  </div>
  <div class="xml-split">
    <ul class="xml-tree" id="xmlTree"></ul>
    <pre class="xml-code" id="xmlCode"></pre>
  </div>
  <div class="data-foot"><span id="xmlFoot">Árbol y texto, sincronizados</span><span class="ok">✓ 0 bytes reescritos</span></div>
</Window>
