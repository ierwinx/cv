---
// Ventana de la home: barra con semáforo y título; el contenido va en el slot.
interface Props { class: string; title?: string }
const { class: cls, title } = Astro.props;
---
<div class:list={['window', cls]}>
  <div class="window-bar"><i></i><i></i><i></i>{(title || Astro.slots.has('title')) && <span><slot name="title">{title}</slot></span>}</div>
  <slot />
</div>
