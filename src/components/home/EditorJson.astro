---
// iJson: árbol ⇄ texto (scripts/home/json.ts; lo monta scripts/pages/home.ts).
import Window from './Window.astro';
---
<Window class="window--json" title="pedido.json">
  <div class="data-toolbar">
    <span class="seg" id="jsonSeg"><b class="on">Árbol ⌘1</b><b>Texto ⌘2</b></span>
    <span class="valid">● JSON válido</span>
  </div>
  <div class="json-views">
    <ul class="json-tree" id="jsonTree"></ul>
    <pre class="json-text" id="jsonText"></pre>
  </div>
</Window>
