---
// iRar: los formatos orbitan el ícono (scripts/home/irar.ts; lo monta scripts/pages/home.ts).
const FORMATS = ['ZIP', 'RAR', '7z', 'TAR', 'GZIP', 'BZIP2', 'XZ', 'ZSTD', 'JAR', 'AAR', 'WAR', 'EAR', 'APK', 'AAB'];
---
<div class="irar-visual" data-irar>
  <img class="irar-icon" src="/assets/icons/irar.png" alt="">
  <div class="formats">{FORMATS.map((f) => <span>{f}</span>)}</div>
</div>
