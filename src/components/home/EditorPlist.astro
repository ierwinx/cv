---
// iPlist editando un Info.plist (scripts/home/plist.ts; lo monta scripts/pages/home.ts).
import Window from './Window.astro';
---
<Window class="window--plist">
  <Fragment slot="title">Info.plist — <em id="plistState">Editado</em></Fragment>
  <div class="data-toolbar">
    <span class="seg" id="plistSeg"><b class="on">XML</b><b>Binario</b></span>
    <span class="search">⌕ Buscar claves y valores</span>
  </div>
  <div class="plist-head"><span>Clave</span><span>Tipo</span><span>Valor</span></div>
  <ul class="plist-rows" id="plistRows"></ul>
  <div class="data-foot"><span id="plistFoot">⌘Z deshace cualquier cambio</span><span class="ok">0 líneas de diff</span></div>
</Window>
