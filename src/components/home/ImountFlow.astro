---
// iMount en la home: carpetas que viajan de un disco de Windows y uno de Linux al Mac (visual de IbridgeFlow).
import IbridgeFlow from './IbridgeFlow.astro';
---
<IbridgeFlow icon="/imount/app-icon.png" glow="rgba(86, 80, 255, 0.45)"
             left={{ emoji: '💾', name: 'Windows', note: 'NTFS', color: '#5ac8fa' }}
             right={{ emoji: '🐧', name: 'Linux', note: 'ext4', color: '#8f8bff' }}
             fly={['📁', '🎬', '📄', '🖼️', '🎵', '📦']} />
