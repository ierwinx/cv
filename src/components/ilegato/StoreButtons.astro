---
// Botones del App Store y de Google Play (enlaces de apps.json). Sin `play`, el de Google Play
// queda como «Próximamente». El slot agrega botones al final.
import { getApp } from '../../lib/apps';

interface Props { icons?: boolean; delay?: string }
const { icons = true, delay } = Astro.props;
const { install, play } = getApp('ilegato');
---
<div class="hero-ctas reveal" style={delay && `--d:${delay}`}>
  <a class="btn btn-primary ring magnetic" href={install} target="_blank" rel="noopener">
    {icons && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 12.6c.02 2.5 2.2 3.33 2.22 3.34-.02.06-.35 1.18-1.14 2.35-.69 1-1.41 2-2.53 2.03-1.11.02-1.47-.66-2.74-.66s-1.66.64-2.71.68c-1.09.04-1.92-1.09-2.61-2.09-1.42-2.05-2.5-5.78-1.05-8.3.72-1.25 2.01-2.05 3.41-2.07 1.07-.02 2.07.72 2.73.72.65 0 1.87-.89 3.16-.76.54.02 2.05.22 3.02 1.64-.08.05-1.8 1.05-1.78 3.13zM14.3 4.98c.58-.7.97-1.67.86-2.64-.83.03-1.84.55-2.44 1.25-.53.62-1 1.61-.88 2.56.93.07 1.88-.47 2.46-1.17z"/></svg>}
    <span>Descargar en el App Store</span>
  </a>
  {play
    ? <a class="btn btn-ghost magnetic" href={play} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.6 2.3c-.3.3-.4.7-.4 1.2v17c0 .5.1.9.4 1.2l9.5-9.7zM15.5 13.4l2.8 2.9-11 6.3c-.4.2-.8.3-1.1.2zM15.5 10.6 6.2 1.2c.3-.1.7 0 1.1.2l11 6.3zM19.6 9.1l2.3 1.3c.9.5.9 1.8 0 2.3l-2.3 1.3-3-3z"/></svg><span>Disponible en Google Play</span></a>
    : <a class="btn btn-ghost btn-soon" aria-disabled="true"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.6 2.3c-.3.3-.4.7-.4 1.2v17c0 .5.1.9.4 1.2l9.5-9.7zM15.5 13.4l2.8 2.9-11 6.3c-.4.2-.8.3-1.1.2zM15.5 10.6 6.2 1.2c.3-.1.7 0 1.1.2l11 6.3zM19.6 9.1l2.3 1.3c.9.5.9 1.8 0 2.3l-2.3 1.3-3-3z"/></svg><span>Próximamente en Google Play</span></a>}
  <slot />
</div>
