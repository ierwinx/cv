---
// Íconos SVG compartidos (los trazos están en lib/icons.ts). Agrega ahí los que se repitan entre páginas.
import { PATHS, FILLED } from '../../lib/icons';

interface Props {
  name: keyof typeof PATHS;
  class?: string;
  stroke?: number;      // grosor del trazo de los íconos de línea
}
const { name, class: cls, stroke = 2.2 } = Astro.props;
const filled = (FILLED as readonly string[]).includes(name);
---
{filled
  ? <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={PATHS[name]} />
  : <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={PATHS[name]} />}
