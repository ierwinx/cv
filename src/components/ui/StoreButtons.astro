---
// Botones del App Store y de Google Play de una app (enlaces de apps.json: `install` y `play`). Sin enlace, el botón
// queda como «Próximamente». El slot agrega botones al final. Lo usan iLegato y La Baraja.
import Button from './Button.astro';
import Icon from './Icon.astro';
import { getApp } from '../../lib/apps';

// bare: sin el contenedor (ya hay uno); only: solo el botón de una tienda
interface Props { slug: string; icons?: boolean; delay?: string; bare?: boolean; only?: 'apple' | 'google' }
const { slug, icons = true, delay, bare = false, only } = Astro.props;
const Wrap = bare ? Fragment : 'div';
const { install, play } = getApp(slug);
---
<Wrap {...(bare ? {} : { class: 'hero-ctas reveal', style: delay && `--d:${delay}` })}>
  {only !== 'google' && (install
    ? <Button href={install} ring external>{icons && <Icon name="apple" />}<span>Descargar en el App Store</span></Button>
    : <Button disabled>{icons && <Icon name="apple" />}<span>Próximamente en el App Store</span></Button>)}
  {only !== 'apple' && (play
    ? <Button href={play} variant="ghost" external><Icon name="google-play" /><span>Disponible en Google Play</span></Button>
    : <Button variant="ghost" disabled><Icon name="google-play" /><span>Próximamente en Google Play</span></Button>)}
  <slot />
</Wrap>
