---
// Botón/enlace del sistema: primary (gradiente con brillo) o ghost (cristal). Magnético por defecto.
import './button.css';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  size?: 'sm';
  download?: boolean;     // descarga: confeti y aviso (core/celebrate.ts)
}
const { href, variant = 'primary', size, download = false } = Astro.props;
---
<a class:list={['btn', `btn-${variant}`, size && `btn-${size}`, 'magnetic']} href={href}
   download={download || undefined} data-download={download || undefined}>
  {variant === 'primary' && <span class="shine"></span>}
  <slot />
</a>
