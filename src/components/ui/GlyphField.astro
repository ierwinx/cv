---
// Símbolos de la app flotando en el fondo (el efecto de iJson). Sale de apps.json → glyphs; lo anima
// core/glyphs.ts (initGlyphs) desde el script de la página. colors: variables CSS, separadas por comas.
import './glyph-field.css';
import type { App } from '../../lib/apps';

interface Props { app: App; colors?: string; density?: number; id?: string }
const { app, colors, density, id } = Astro.props;
---
{app.glyphs?.length && <canvas id={id} class="ui-glyphs" data-glyph-field data-glyphs={JSON.stringify(app.glyphs)}
        data-colors={colors} data-density={density} aria-hidden="true"></canvas>}
