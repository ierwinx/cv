---
// Botón de descarga del instalador de la app (GitHub Releases, ver apps.json → release).
import Button from './Button.astro';
import { downloadUrl, type App } from '../../lib/apps';

interface Props { app: App; size?: 'sm' }
const { app, size } = Astro.props;
---
<Button href={downloadUrl(app)} size={size} download><slot /></Button>
