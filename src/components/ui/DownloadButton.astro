---
// Botón de descarga del instalador de la app (GitHub Releases, ver apps.json → release).
import Button from './Button.astro';
import { downloadUrl, type App } from '../../lib/apps';

interface Props { app: App; size?: 'sm' | 'lg'; variant?: 'primary' | 'ghost'; ring?: boolean }
const { app, size, variant, ring } = Astro.props;
---
<Button href={downloadUrl(app)} size={size} variant={variant} ring={ring} download><slot /></Button>
