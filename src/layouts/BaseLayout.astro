---
// Documento común a TODAS las páginas: <head>, favicon, fuentes, seasonal, enlace «saltar al contenido»
// y la pausa de animaciones CSS fuera de pantalla.
// No trae estilos de diseño: cada familia de páginas los aporta (AppLayout, o los de la propia página).
// El SEO (canonical, Open Graph, JSON-LD) lo agrega tools/seo.py después del build.
import '../styles/document.css';

interface Props {
  title: string;
  description: string;
  icon?: string;                 // favicon png o svg (ruta absoluta); para varios, usa el slot "head"
  touchIcon?: string;            // ícono de iOS si no es el mismo favicon
  themeColor?: string;
  skipTo?: string | false;       // id del contenido principal (enlace «saltar al contenido»)
  seasonal?: boolean;            // efectos de temporada (assets/seasonal.*); false en páginas utilitarias
  fonts?: string;                // familias de Google Fonts: "Inter:wght@400;700&family=..."
  vars?: Record<string, string>; // tokens del tema en <html style>
  lang?: string;
  htmlClass?: string;
  bodyClass?: string;
}
const { title, description, icon, touchIcon = icon, themeColor, fonts, vars = {}, lang = 'es', skipTo = 'contenido', seasonal = true, htmlClass, bodyClass } = Astro.props;
const style = Object.entries(vars).map(([k, v]) => `${k}:${v}`).join(';');
---
<!doctype html>
<html lang={lang} class={htmlClass} style={style || undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{icon && <><link rel="icon" type={icon.endsWith('.svg') ? 'image/svg+xml' : 'image/png'} href={icon}><link rel="apple-touch-icon" href={touchIcon}></>}
{themeColor && <meta name="theme-color" content={themeColor}>}
<title>{title}</title>
<meta name="description" content={description}>
{fonts && <>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href={`https://fonts.googleapis.com/css2?family=${fonts}&display=swap`} rel="stylesheet">
</>}
<slot name="head" />
{seasonal && <link rel="stylesheet" href="/assets/seasonal.css">}
</head>
<body class={bodyClass}>
{skipTo && <a class="skip-link" href={`#${skipTo}`}>Saltar al contenido</a>}
<!-- Aro que sigue al cursor del sistema y crece sobre enlaces y botones -->
<div class="custom-cursor--trail" id="custom-cursor-trail" aria-hidden="true"></div>
<slot />
{seasonal && <script is:inline src="/assets/seasonal.js" defer></script>}
<!-- Pausa las animaciones CSS de los bloques que no se ven (órbitas, brillos…): el navegador deja de
     repintarlos. La regla [data-offscreen] está en styles/document.css. Inline: son 300 bytes en todas las páginas. -->
<script is:inline>
  (() => {
    const io = new IntersectionObserver((es) => { for (const e of es) e.target.toggleAttribute('data-offscreen', !e.isIntersecting); }, { rootMargin: '200px 0px' });
    document.querySelectorAll('body > :not(script):not(main), main > *').forEach((el) => io.observe(el));
  })();
</script>
<!-- Aro del cursor: transform (sin recalcular diseño), velocidad independiente de los fps y el bucle
     se detiene cuando alcanza al ratón. Inline para que funcione en todas las páginas. -->
<script is:inline>
  (() => {
    if (matchMedia('(prefers-reduced-motion: reduce), (pointer: coarse)').matches) return;
    const trail = document.getElementById('custom-cursor-trail');
    if (!trail) return;
    const HOVERABLES = 'a, button, [role="button"], [data-download], input, select, textarea, [tabindex]';
    let mx = 0, my = 0, tx = 0, ty = 0, raf = 0, last = 0, shown = false;
    const put = () => { trail.style.transform = `translate3d(${tx}px, ${ty}px, 0)`; };
    const step = (t) => {
      const dt = Math.min(t - last, 100); last = t;
      const k = 1 - Math.pow(0.85, dt / 16.67); // = 0.15 por cuadro a 60 fps
      tx += (mx - tx) * k; ty += (my - ty) * k;
      if (Math.abs(mx - tx) < 0.1 && Math.abs(my - ty) < 0.1) { tx = mx; ty = my; put(); raf = 0; return; }
      put(); raf = requestAnimationFrame(step);
    };
    document.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      mx = e.clientX; my = e.clientY;
      if (!shown) { shown = true; tx = mx; ty = my; put(); trail.classList.add('is-on'); }
      if (!raf) { last = performance.now(); raf = requestAnimationFrame(step); }
    }, { passive: true });
    document.documentElement.addEventListener('mouseleave', () => { shown = false; trail.classList.remove('is-on'); });
    const hover = (on) => (e) => {
      if (e.target.closest?.(HOVERABLES)) trail.classList.toggle('custom-cursor--trail--hover', on);
    };
    document.addEventListener('mouseover', hover(true));
    document.addEventListener('mouseout', hover(false));
  })();
</script>
</body>
</html>
