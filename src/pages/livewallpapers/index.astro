---
// LiveWallpapers: videos como fondo de escritorio y pantalla de bloqueo del Mac. Página del sistema aurora; la demo
// del hero (LivewallpapersDemo) es la misma que la de la home y la monta el script de abajo.
import AppLayout from '../../layouts/AppLayout.astro';
import Footer from '../../components/layout/Footer.astro';
import DownloadButton from '../../components/ui/DownloadButton.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Hero from '../../components/sections/Hero.astro';
import Section from '../../components/sections/Section.astro';
import Bento from '../../components/sections/Bento.astro';
import BentoCard from '../../components/sections/BentoCard.astro';
import Steps from '../../components/sections/Steps.astro';
import CompareTable from '../../components/sections/CompareTable.astro';
import Principles from '../../components/sections/Principles.astro';
import Faq from '../../components/sections/Faq.astro';
import DownloadCta from '../../components/sections/DownloadCta.astro';
import AppWindow from '../../components/mockups/AppWindow.astro';
import LivewallpapersDemo from '../../components/demos/LivewallpapersDemo.astro';
import { getApp } from '../../lib/apps';
import { getLegal } from '../../lib/legal';

const app = getApp('livewallpapers');
---
<AppLayout slug="livewallpapers" stars
  nav={[['#funciones', 'Funciones'], ['#como', 'Cómo funciona'], ['#comparativa', 'Comparativa'], ['#preguntas', 'Preguntas']]}
  toast="🎉 ¡Gracias por descargar LiveWallpapers! Arrástrala a Aplicaciones y suelta tu primer video.">

  <Hero icon={app.home!.logo} iconAlt="Ícono de LiveWallpapers" pill={`LiveWallpapers ${app.version} · nativo para macOS 27`}
        title="Tu fondo de pantalla," accent="en movimiento."
        meta={['Firmado y notarizado por Apple', 'Escritorio y pantalla de bloqueo', 'Gratis']}>
    <Fragment slot="lead">Arrastra un video y LiveWallpapers lo pone como <strong>fondo de escritorio y de la pantalla de bloqueo</strong>, siempre en movimiento. Vive en la <strong>barra de menú</strong>, se pausa sola cuando no lo ves y no toca los fondos de Apple.</Fragment>
    <Fragment slot="cta">
      <DownloadButton app={app}><Icon name="apple" /> Descargar para macOS</DownloadButton>
      <Button href="#como" variant="ghost">Ver cómo funciona <Icon name="arrow-down" /></Button>
    </Fragment>
    <AppWindow class="lw-window" label="Así se ve LiveWallpapers"><LivewallpapersDemo /></AppWindow>
  </Hero>

  <main id="contenido">
    <Section id="funciones" eyebrow="funciones" title="Un video." accent="Dos pantallas."
             sub="macOS trae fondos en movimiento, pero solo los suyos. LiveWallpapers registra tu video como uno más, así que se ve en la pantalla de bloqueo, y además lo deja corriendo en el escritorio.">
      <Bento>
        <BentoCard span={4} title="Escritorio y pantalla de bloqueo, en un clic" icon='<rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 21h8M12 18v3"/><path d="M10 8.5v5l4-2.5z"/>'>
          <Fragment slot="text">Elige un video y pulsa <b>Poner como fondo y pantalla de bloqueo</b>. Al bloquear el Mac lo ves detrás de la hora, y al volver sigue en tu escritorio, en bucle y debajo de los íconos.</Fragment>
        </BentoCard>
        <BentoCard span={2} title="Arrastra cualquier video" icon='<path d="M12 3v12M7 10l5 5 5-5"/><path d="M4 17v3h16v-3"/>'>
          <Fragment slot="text">Suelta un <code class="kbd">.mov</code>, <code class="kbd">.mp4</code> o <code class="kbd">.m4v</code> sobre la ventana. Si ya está listo, se copia a tu carpeta de videos.</Fragment>
        </BentoCard>
        <BentoCard span={2} title="Recorta los 30 s que quieres" bg="rgba(255,179,64,.14)" stroke="#ffd08a" icon='<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M8.1 8.1 20 20M8.1 15.9 20 4"/>'>
          <Fragment slot="text">Si dura más, eliges dónde empieza con una vista previa en bucle, y la app guarda ese tramo en HEVC, sin audio.</Fragment>
        </BentoCard>
        <BentoCard span={2} title="Se pausa sola" icon='<rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>'>
          <Fragment slot="text">Al apagar la pantalla, bloquear el Mac o cambiar de usuario, el video se detiene. Vuelve a correr cuando regresas.</Fragment>
        </BentoCard>
        <BentoCard span={2} title="En todos tus monitores" bg="rgba(126,166,255,.14)" stroke="#b5ccff" icon='<rect x="1" y="5" width="13" height="10" rx="1.5"/><rect x="10" y="9" width="13" height="10" rx="1.5"/>'>
          <Fragment slot="text">Una ventana por pantalla, con el mismo video. Si conectas o quitas un monitor, se acomoda sola.</Fragment>
        </BentoCard>
        <BentoCard span={3} title="Vive en la barra de menú" icon='<path d="M3 5h18"/><rect x="13" y="8" width="8" height="11" rx="1.5"/><path d="M15 11h4M15 14h4"/>'>
          <Fragment slot="text">Sin ícono en el Dock. Desde su menú ves qué video corre, lo detienes, abres la ventana o activas <b>Abrir al iniciar sesión</b> para que tu fondo arranque con el Mac.</Fragment>
        </BentoCard>
        <BentoCard span={3} title="Convierte lo que macOS no reproduce" bg="rgba(255,107,74,.14)" stroke="#ffb3a0" icon='<path d="M4 12a8 8 0 0 1 14-5.3L20 9"/><path d="M20 4v5h-5"/><path d="M20 12a8 8 0 0 1-14 5.3L4 15"/><path d="M4 20v-5h5"/>'>
          <Fragment slot="text">¿Un video en AV1 que tu Mac no abre? Si tienes <code class="kbd">ffmpeg</code> de Homebrew, LiveWallpapers lo convierte a HEVC con el chip de video de tu Mac.</Fragment>
        </BentoCard>
      </Bento>
    </Section>

    <Section id="como" flush center eyebrow="listo en un minuto" title="Arrastra. Elige." accent="Bloquea.">
      <Steps items={[
        ['Arrastra', 'Suelta un video en la ventana de LiveWallpapers o ponlo en <code class="kbd">~/Movies/LiveWallpapers</code> y pulsa <b>Recargar</b>.'],
        ['Elige', 'Si dura más de 30 segundos, escoge el tramo con la vista previa. La app lo deja listo en HEVC.'],
        ['Aplica', 'Pulsa <b>Poner como fondo y pantalla de bloqueo</b>. Bloquea tu Mac con ⌃⌘Q y míralo.'],
      ]} />
    </Section>

    <Section id="comparativa" center eyebrow="por qué LiveWallpapers" title="Tus videos," accent="no solo los de Apple."
             sub="Los fondos aéreos de macOS se ven increíbles, pero no puedes poner los tuyos y en el escritorio se quedan quietos.">
      <CompareTable columns={['LiveWallpapers', 'Fondos aéreos de macOS']} rows={[
        ['Tus propios videos', true, false],
        ['En la pantalla de bloqueo', true, true],
        ['En movimiento en el escritorio', 'Siempre', 'Solo al desbloquear'],
        ['Recorte y conversión a HEVC', true, false],
        ['Se pausa al bloquear o apagar la pantalla', true, true],
        ['Gratis', true, true],
      ]} />
    </Section>

    <Section flush eyebrow="ingeniería" title="Hecho para el Mac." accent="Y para tu batería.">
      <Principles items={[
        ['No toca los fondos de Apple', 'Tu video se registra como un fondo nuevo, con su propio identificador. Los fondos de Apple y los de otras apps se quedan como estaban.'],
        ['Un solo video a la vez', 'Al aplicar otro, LiveWallpapers borra la copia del anterior. No llena tu disco de videos repetidos.'],
        ['Por hardware', 'Los videos van en HEVC, que el chip de video de Apple Silicon decodifica sin cargar al procesador. Y si no lo ves, se pausa.'],
        ['Se recupera sola', 'Si macOS deja la pantalla de bloqueo en negro o el escritorio congelado tras un bloqueo largo, la app reinicia el reproductor por ti.'],
      ]} />
    </Section>

    <Section id="preguntas" flush center eyebrow="preguntas" title="Antes de" accent="darle play.">
      <Faq items={getLegal('livewallpapers').faq} />
    </Section>

    <DownloadCta app={app} eyebrow="suelta tu primer video" title="Tu Mac," accent="en movimiento."
                 sub="Descarga LiveWallpapers, arrástrala a Aplicaciones y suelta un video en su ventana. Sin cuentas, sin anuncios y gratis."
                 requirements={['macOS 27 o posterior', 'Solo Apple Silicon', app.size!, 'Firmado con Developer ID', 'Notarizado por Apple']}>
      <DownloadButton app={app}><Icon name="download" /> Descargar LiveWallpapers {app.version} (.dmg)</DownloadButton>
    </DownloadCta>
  </main>

  <Footer slot="footer" app={app} giant tagline="Videos como fondo de escritorio y pantalla de bloqueo. Hecho para que tu Mac se vea vivo." />
</AppLayout>

<script>
  import { mount } from '../../scripts/demos/livewallpapers';
  document.querySelectorAll<HTMLElement>('[data-lw]').forEach(mount);
</script>
