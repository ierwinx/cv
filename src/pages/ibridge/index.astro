---
import AppLayout from '../../layouts/AppLayout.astro';
import Footer from '../../components/layout/Footer.astro';
import DownloadButton from '../../components/ui/DownloadButton.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Hero from '../../components/sections/Hero.astro';
import Marquee from '../../components/sections/Marquee.astro';
import Section from '../../components/sections/Section.astro';
import Bento from '../../components/sections/Bento.astro';
import BentoCard from '../../components/sections/BentoCard.astro';
import Steps from '../../components/sections/Steps.astro';
import CompareTable from '../../components/sections/CompareTable.astro';
import Principles from '../../components/sections/Principles.astro';
import Faq from '../../components/sections/Faq.astro';
import DownloadCta from '../../components/sections/DownloadCta.astro';
import IbridgeDemo from '../../components/demos/IbridgeDemo.astro';
import { getApp } from '../../lib/apps';
import '../../styles/pages/ibridge.css';

const app = getApp('ibridge');
---
<AppLayout slug="ibridge" stars
  nav={[['#dispositivos', 'iPhone y Android'], ['#funciones', 'Funciones'], ['#comparativa', 'Comparativa'], ['#preguntas', 'Preguntas']]}
  toast="🎉 ¡Gracias por descargar iBridge! Arrástralo a Aplicaciones y conecta tu teléfono.">

  <Hero icon={app.icon!} iconAlt="Ícono de iBridge" pill="iBridge 1.0 · nativo para macOS 27"
        title="Tu iPhone y tu Android," accent="en tu Mac."
        meta={['Firmado y notarizado por Apple', 'iPhone, iPad y Android', 'Sin cuentas ni nube']}>
    <Fragment slot="lead">Conecta el teléfono con un cable y verás tus <strong>fotos, videos y archivos</strong> como en el Finder. Cópialos a tu Mac, mándalos al teléfono o <strong>arrástralos</strong>. Tan sencillo que <strong>cualquiera en la familia</strong> lo puede usar sin ayuda.</Fragment>
    <Fragment slot="cta">
      <DownloadButton app={app}><Icon name="apple" /> Descargar para macOS</DownloadButton>
      <Button href="#dispositivos" variant="ghost">Ver cómo funciona <Icon name="arrow-down" /></Button>
    </Fragment>
    <IbridgeDemo />
  </Hero>

  <Marquee items={['Fotos y videos', 'Arrastrar al Finder', 'WhatsApp', 'Descargas', 'Archivos de apps', 'Vista rápida', 'Papelera de iBridge', 'Android por Wi‑Fi', 'Dos teléfonos a la vez', 'Letra grande']} />

  <main id="contenido">
    <Section id="dispositivos" center eyebrow="un puente, dos mundos" title="Una sola app para" accent="todos tus teléfonos."
             sub="El Finder solo entiende al iPhone a medias y el Android ni lo ve. iBridge habla con los dos y te los muestra igual: carpetas con nombre, miniaturas grandes y botones que dicen lo que hacen.">
      <div class="devices">
        <div class="devcard tilt reveal" style="--c:#0a84ff">
          <div class="logo"><Icon name="apple" /></div>
          <h3>iPhone y iPad</h3>
          <p>Por cable o por Wi‑Fi. Toca «Confiar» una vez y listo: sin iTunes, sin sincronizar, sin jailbreak.</p>
          <ul class="zones">
            <li><span class="em">🖼️</span><div><b>Fotos y videos</b><span>Todo tu carrete, ordenado por meses. Cópialo a tu Mac o bórralo del teléfono y la app Fotos se entera.</span></div></li>
            <li><span class="em">📂</span><div><b>Archivos de apps</b><span>Lo que guardan VLC, Documents, Pages o Keynote. Ahí también puedes enviar archivos desde el Mac.</span></div></li>
            <li><span class="em">🔋</span><div><b>Batería y espacio libre</b><span>De un vistazo, antes de copiar ese video enorme.</span></div></li>
          </ul>
        </div>
        <div class="devcard tilt reveal" style="--c:#3ddc84">
          <div class="logo"><Icon name="android" /></div>
          <h3>Android</h3>
          <p>Teléfonos y tablets de cualquier marca. <code class="kbd">adb</code> viene dentro de la app: no instalas nada más.</p>
          <ul class="zones">
            <li><span class="em">⚡</span><div><b>Modo rápido</b><span>Con la depuración USB activada: acceso completo, muy estable y también funciona por Wi‑Fi.</span></div></li>
            <li><span class="em">🔌</span><div><b>Modo sencillo</b><span>Elige «Transferencia de archivos» en el aviso del teléfono y ya. Sin configurar nada.</span></div></li>
            <li><span class="em">💬</span><div><b>Lugares con nombre</b><span>Fotos y videos, Descargas, Documentos, WhatsApp y Música… y «Todas las carpetas» para quien quiera ver todo.</span></div></li>
          </ul>
        </div>
      </div>
    </Section>

    <Section id="funciones" flush eyebrow="funciones" title="Todo lo que haces en el Finder." accent="Ahora en tu teléfono."
             sub="Copiar, mover, renombrar, borrar y arrastrar. Con la seguridad de que nada se pierde por accidente.">
      <Bento>
        <BentoCard span={4} title="Arrastra y suelta, en los dos sentidos" icon='<path d="M5 9l4-4 4 4"/><path d="M9 5v10"/><path d="M19 15l-4 4-4-4"/><path d="M15 19V9"/>'>
          <Fragment slot="text">Selecciona veinte fotos y arrástralas a una carpeta del Finder. O suelta un PDF del escritorio sobre la ventana del teléfono. Con dos teléfonos conectados, arrastra de una ventana a la otra.</Fragment>
          <div class="flow"><span class="node">📱 iPhone</span><span class="arrow"></span><span class="node">💻 Mac</span><span class="arrow"></span><span class="node">🤖 Android</span></div>
        </BentoCard>
        <BentoCard title="Papelera de iBridge" bg="rgba(61,220,132,.14)" stroke="#7dffb0" icon='<path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/>'>
          <Fragment slot="text">Antes de borrar algo del teléfono, iBridge guarda una copia en tu Mac durante 30 días. Por si acaso.</Fragment>
        </BentoCard>
        <BentoCard title="Dos teléfonos a la vez" bg="rgba(90,200,250,.14)" stroke="#a8e4ff" icon='<rect x="2" y="4" width="9" height="16" rx="2"/><rect x="13" y="4" width="9" height="16" rx="2"/>'>
          <Fragment slot="text">Cada dispositivo abre su propia ventana y tiene su color, para no confundir el iPhone con el Android.</Fragment>
        </BentoCard>
        <BentoCard title="Vista rápida" bg="rgba(255,198,92,.14)" stroke="#ffd98a" icon='<circle cx="12" cy="12" r="3"/><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/>'>
          <Fragment slot="text">Pulsa <span class="kbd">espacio</span> y mira la foto, el video o el PDF sin copiarlo antes.</Fragment>
        </BentoCard>
        <BentoCard title="¿Ya existe? Te pregunta" bg="rgba(255,120,150,.14)" stroke="#ffadc0" icon='<path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><circle cx="12" cy="12" r="5"/>'>
          <Fragment slot="text">Si un archivo ya está en el destino, eliges: reemplazar, conservar los dos o saltarlo. Para uno o para todos.</Fragment>
        </BentoCard>
        <BentoCard span={3} title="Pensada para que nadie se pierda" icon='<path d="M4 7V5h16v2"/><path d="M9 20h6"/><path d="M12 5v15"/>'>
          <Fragment slot="text">Letra que puedes agrandar, íconos grandes y palabras de todos los días. Los errores te dicen qué hacer, no un código.</Fragment>
          <div class="say">
            <div><s>Error AFC 0xE8000015</s> → <b>«Desbloquea tu iPhone y toca Reintentar»</b></div>
            <div><s>/sdcard/Download</s> → <b>«Descargas»</b></div>
          </div>
        </BentoCard>
        <BentoCard span={3} title="Te avisa cuando termina" bg="rgba(61,220,132,.14)" stroke="#7dffb0" icon='<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>'>
          <Fragment slot="text">Copia cientos de fotos y sigue con lo tuyo: una barra te dice cuánto falta en palabras («Quedan unos 3 minutos») y suena un aviso al terminar. Puedes cancelar cuando quieras.</Fragment>
        </BentoCard>
      </Bento>
    </Section>

    <Section flush center eyebrow="listo en un minuto" title="Conecta. Elige." accent="Copia.">
      <Steps items={[
        ['Conecta', 'Usa el cable de siempre. iBridge reconoce el teléfono solo y te muestra su nombre, su batería y su espacio libre.'],
        ['Elige', 'Abre «Fotos y videos», «Descargas» o «WhatsApp» y marca lo que quieras. Las miniaturas aparecen al instante.'],
        ['Copia', 'Pulsa «Copiar a mi Mac» o arrástralo a donde quieras. Si algo falta para conectar, la ayuda te lo explica paso a paso.'],
      ]} />
    </Section>

    <Section id="comparativa" center eyebrow="por qué iBridge" title="Lo que el Mac" accent="no hace solo."
             sub="macOS te da una herramienta para cada cosa y ninguna para todo. iBridge junta en una sola ventana lo que hoy te obliga a saltar entre apps, o que simplemente no se puede.">
      <CompareTable columns={['iBridge', 'Finder', 'Captura de Imagen']} rows={[
        ['iPhone y Android en la misma app', true, false, 'Solo fotos'],
        ['Carrete del iPhone', true, false, true],
        ['Archivos de las apps del iPhone', true, true, false],
        ['Todas las carpetas de Android', true, false, false],
        ['Renombrar y mover en el teléfono', true, false, false],
        ['Copia de seguridad antes de borrar', true, false, false],
        ['Android por Wi‑Fi', true, false, false],
      ]} />
    </Section>

    <Section flush eyebrow="ingeniería" title="Hecho para el Mac." accent="Y para tu privacidad.">
      <Principles items={[
        ['100 % local', 'Tus fotos van del teléfono al Mac por el cable o por tu red de casa. Sin cuentas, sin nube, sin anuncios y sin rastreo.'],
        ['Swift 6 y SwiftUI', 'App nativa para Apple Silicon. Cada teléfono trabaja por su lado, así que la ventana nunca se congela aunque copies miles de archivos.'],
        ['Respeta tu iPhone', 'El carrete se borra por la misma vía que usa Captura de Imagen, así la app Fotos del iPhone queda en orden y sin huecos.'],
        ['No pelea con Android Studio', 'Si ya tienes un servidor <span class="kbd">adb</span> corriendo, iBridge lo usa. Si no, enciende el suyo y lo apaga al cerrar.'],
      ]} />
    </Section>

    <Section id="preguntas" flush center eyebrow="preguntas" title="Antes de" accent="conectar.">
      <Faq items={[
        ['¿Puedo pasar fotos del Mac a la app Fotos del iPhone?', 'No directamente: iOS no deja que otras apps agreguen fotos a su carrete. iBridge te ofrece enviarlas a la carpeta de una app (por ejemplo, Documents o VLC) y te lo explica en pantalla.'],
        ['¿Por qué no veo todas mis fotos del iPhone?', 'Si tienes activado «Optimizar almacenamiento» de Fotos de iCloud, muchas fotos viven solo en la nube. iBridge muestra las que de verdad están guardadas en el teléfono.'],
        ['¿Qué modo uso con mi Android?', 'El modo sencillo funciona sin configurar nada: solo elige «Transferencia de archivos» al conectar. Si vas a copiar mucho, activa la depuración USB una vez y usa el modo rápido: es más veloz, más estable y además funciona por Wi‑Fi. La ayuda dentro de la app te guía paso a paso.'],
        ['¿Necesito instalar algo más?', 'No. Todo lo necesario viene dentro de la app. Solo arrastra iBridge a Aplicaciones y ábrela.'],
        ['¿Funciona en Macs con Intel?', 'No. iBridge está hecho solo para Macs con Apple Silicon (M1 o posterior) y macOS 27 o posterior.'],
      ]} />
    </Section>

    <DownloadCta eyebrow="conecta y listo" title="Tus recuerdos," accent="a un cable de distancia."
                 sub="Descarga iBridge, arrástralo a Aplicaciones y conecta tu teléfono. Esas fotos que llevas meses queriendo pasar al Mac te están esperando."
                 requirements={['macOS 27 o posterior', 'Solo Apple Silicon', '11,6 MB', 'Firmado con Developer ID', 'Notarizado por Apple']}>
      <DownloadButton app={app}><Icon name="download" /> Descargar iBridge 1.0 (.dmg)</DownloadButton>
    </DownloadCta>
  </main>

  <Footer slot="footer" app={app} note="Hecho con cariño para toda la familia." tagline="iPhone, iPad y Android, en tu Mac." />
</AppLayout>
