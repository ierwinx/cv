---
// Hojas del CV para tools/cv_pdf.py, que las convierte en dist/CV/Erwin-cv-EN.pdf y Erwin-cv-ES.pdf (WeasyPrint,
// texto vectorial) y luego cambia esta página por una redirección al PDF. Sin JS: en `npm run dev` sirve para
// ver y ajustar la hoja (src/components/cv/Resume.astro + src/styles/pages/cv-pdf.css) tal como sale en el PDF.
import Resume from '../../../components/cv/Resume.astro';
import cv from '../../../data/cv.json';
import '../../../styles/pages/cv-pdf.css';

const langs = ['en', 'es'] as const;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{cv.pdf.en.name} · CV</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="cv-sheets">
  {langs.map((lang) => <article class="cv-sheet" id={`cv-${lang}`} lang={lang}><Resume lang={lang} /></article>)}
</body>
</html>
