---
// iConverter se mudó a /iconverter/. Esta página solo redirige los enlaces viejos
// (GitHub Pages no permite redirecciones 301 en el servidor). seo.py la deja fuera del sitemap.
const target = '/iconverter/';
const canonical = new URL(target, Astro.site).href;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>iConverter se mudó · ierwinx</title>
<meta name="robots" content="noindex, follow">
<link rel="canonical" href={canonical}>
<meta http-equiv="refresh" content={`0; url=${target}`}>
<script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script>
</head>
<body>
<p>iConverter ahora está en <a href={target}>{canonical.replace(/^https?:\/\//, '')}</a>.</p>
</body>
</html>
