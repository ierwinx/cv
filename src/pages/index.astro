---
// Home de ierwinx. Menú, órbita, dock y pie salen de apps.json; los spotlights, de src/data/home.json.
// Cada visual es un componente con su demo; iGit e iConverter usan las mismas demos que sus páginas.
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/home.css';
import BrandMark from '../components/home/BrandMark.astro';
import PythonLogo from '../components/home/PythonLogo.astro';
import AppIcon from '../components/home/AppIcon.astro';
import Spot from '../components/home/Spot.astro';
import PhoneShowcase from '../components/home/PhoneShowcase.astro';
import IrarOrbit from '../components/home/IrarOrbit.astro';
import IbridgeFlow from '../components/home/IbridgeFlow.astro';
import ImountFlow from '../components/home/ImountFlow.astro';
import IgitTerm from '../components/home/IgitTerm.astro';
import ItunesTerm from '../components/home/ItunesTerm.astro';
import Spectrogram from '../components/home/Spectrogram.astro';
import IconverterDemo from '../components/demos/IconverterDemo.astro';
import EditorPlist from '../components/home/EditorPlist.astro';
import EditorJson from '../components/home/EditorJson.astro';
import EditorCsv from '../components/home/EditorCsv.astro';
import EditorXml from '../components/home/EditorXml.astro';
import CodeWindow from '../components/home/CodeWindow.astro';
import apps from '../data/apps.json';
import home from '../data/home.json';
import site from '../data/site.json';
import cv from '../data/cv.json';
import { getApp, type App } from '../lib/apps';

const all = apps as App[];
const PHONES: Record<string, { shots: [string, string][]; cards: [string, string, string][]; background?: string }> = {
  superpets: { shots: [['/superpets/img/foto1.PNG', 'Super Pets: felicitación de cumpleaños de Caramelo'], ['/superpets/img/foto2.PNG', ''], ['/superpets/img/foto10.PNG', '']],
    cards: [['💉', 'Vacuna antirrábica', 'Mañana · 10:00'], ['🎂', '¡Caramelo cumple 8!', 'Hoy'], ['🏆', '+25 puntos', 'Perfil completo']] },
  ilegato: { shots: [['/ilegato/img/iphone-reproductor.webp', 'iLegato: reproductor con FLAC de 24 bits'], ['/ilegato/img/iphone-artista.webp', ''], ['/ilegato/img/iphone-ecualizador.webp', ''], ['/ilegato/img/iphone-letras.webp', '']],
    cards: [['🎧', 'FLAC · 24 bit', 'Sin pérdida'], ['🎚️', 'Metalcore', 'Ecualizador · 10 bandas'], ['🚗', 'CarPlay y Android Auto', 'Tu música en el auto']], background: '#07070c' },
};
const VISUALS: Record<string, any> = {
  irar: IrarOrbit, ibridge: IbridgeFlow, imount: ImountFlow, igit: IgitTerm, itunes: ItunesTerm, ispecter: Spectrogram, iconverter: IconverterDemo,
  iplist: EditorPlist, ijson: EditorJson, icsv: EditorCsv, ixml: EditorXml,
};

// Órbita del hero: anillo interior (editores) y exterior (el resto), con su ángulo.
const RING1: [string, number][] = [['ijson', 0], ['iplist', 90], ['icsv', 180], ['ixml', 270]];
const RING2: [string, number][] = [['irar', 30], ['ispecter', 90], ['igit', 150], ['itunes', 210], ['iconverter', 270], ['superpets', 330]];
const CHIPS: [string, number][] = [['Swift 6', 30], ['SwiftUI', 120], ['Metal', 210], ['Storyboards', 300]];
const TECH = ['Swift 6', 'SwiftUI', 'AppKit', 'Metal', 'Apple Silicon', 'WidgetKit', 'CarPlay', 'watchOS', 'Kotlin', 'Jetpack Compose', 'Python', 'Django', 'FastAPI', 'AWS', 'Docker', 'Kubernetes'];
const CLIENTS = ['Banco Azteca', 'Super App BAZ', 'STP', 'PagApp', 'STCodig', 'Grupo Salinas', 'Secretaría de Gobernación'];
const MODULES = ['Primeros pasos', 'Fundamentos de Python', 'Aplicaciones de terminal', 'Apps de escritorio con Tkinter', 'Webs con Django', 'APIs REST con FastAPI y DRF'];
const editorsDesc = 'Cuatro editores nativos que hacen una sola cosa cada uno, muy rápido, y guardan tu archivo exactamente como estaba.';
---
<BaseLayout title="ierwinx · Software nativo, hecho con obsesión" description={site.description} themeColor="#07070c"
            fonts="Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700" skipTo="top">
  <Fragment slot="head">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/assets/favicon-48.png" sizes="48x48" type="image/png">
    <link rel="icon" href="/assets/icon-192.png" sizes="192x192" type="image/png">
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  </Fragment>

  <div class="aurora" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div class="spotlight" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="progress" aria-hidden="true"></div>

  <!-- ── Nav ── -->
  <header class="nav" id="nav">
    <a class="brand" href="#top" aria-label="ierwinx, inicio">
      <BrandMark defs class="brand-mark" />
      <span>ierwinx</span>
    </a>
    <nav class="nav-links" aria-label="Secciones">
      <a href="#suite">Suite</a>
      <div class="dd">
        <a class="dd-trigger" href="#suite" aria-haspopup="true">
          Apps
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div class="dd-panel">
          <p class="dd-title">Todas mis apps</p>
          <div class="dd-grid">
            {all.map((app) => (
              <a class="dd-item" href={`#${app.slug}`}>
                <AppIcon app={app} />
                <span><b>{app.name}{app.home?.new && <> <em>Nuevo</em></>}</b><small>{app.home?.tagline}</small></span>
              </a>
            ))}
            <a class="dd-item" href="#academia">
              <PythonLogo />
              <span><b>Curso de Python</b><small>220 lecciones gratis</small></span>
            </a>
          </div>
          <a class="dd-all" href="#suite">Ver toda la suite →</a>
        </div>
      </div>
      <a href="#academia">Academia</a>
    </nav>
  </header>

  <main id="top">
    <!-- ── Hero ── -->
    <section class="hero">
      <div class="hero-copy">
        <a class="pill reveal" href="#ibridge">
          <span class="pill-dot"></span>
          <span>Nuevo · iBridge: tu iPhone y tu Android, en tu Mac</span>
          <span class="pill-arrow">→</span>
        </a>
        <h1 class="hero-title">
          <span class="line"><span class="word">Software</span> <span class="word">nativo,</span></span>
          <span class="line"><span class="word">hecho</span> <span class="word">con</span> <span class="word gradient-text">obsesión.</span></span>
        </h1>
        <p class="hero-sub reveal">
          ierwinx es el estudio independiente de <strong>Erwin</strong>: una suite de apps
          para Mac, iPhone, iPad, Apple Watch, CarPlay y la terminal, diseñadas a mano, ligeras y sin rastreo.
        </p>
        <p class="hero-rotator reveal" aria-live="polite">
          Hecho para tu <span class="rotator" id="rotator">Mac.</span>
        </p>
        <div class="hero-ctas reveal">
          <a class="btn btn--primary magnetic" href="#suite">Explorar la suite</a>
        </div>
        <dl class="hero-stats reveal">
          <div><dt><span data-count={all.length}>0</span></dt><dd>apps publicadas</dd></div>
          <div><dt><span data-count="220">0</span></dt><dd>lecciones gratis</dd></div>
          <div><dt><span data-count={new Date().getFullYear() - cv.careerStart} data-suffix="+" data-since={cv.careerStart}>0</span></dt><dd>años de oficio</dd></div>
          <div><dt>0</dt><dd>anuncios. Nunca.</dd></div>
        </dl>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="orbit" id="orbit">
          <div class="orbit-core"><BrandMark /></div>
          <div class="ring ring--1">{RING1.map(([slug, a]) => <div class="node" style={`--a:${a}deg`}><AppIcon app={getApp(slug)} /></div>)}</div>
          <div class="ring ring--2">{RING2.map(([slug, a]) => <div class="node" style={`--a:${a}deg`}><AppIcon app={getApp(slug)} /></div>)}</div>
          <div class="ring ring--3">{CHIPS.map(([chip, a]) => <div class="node node--chip" style={`--a:${a}deg`}><span>{chip}</span></div>)}</div>
        </div>
      </div>
    </section>

    <!-- ── Tecnologías ── -->
    <div class="marquee" aria-label="Tecnologías">
      <div class="marquee-track">
        {TECH.map((t) => <span>{t}</span>)}{TECH.map((t) => <span aria-hidden="true">{t}</span>)}
      </div>
    </div>

    <!-- ── Suite ── -->
    <section class="section" id="suite">
      <div class="section-head reveal">
        <p class="eyebrow">La suite ierwinx</p>
        <h2 class="section-title">Trece apps.<br><span class="muted">Una misma obsesión por los detalles.</span></h2>
      </div>
    </section>

    {home.spots.map((spot, i) => {
      const Visual = VISUALS[spot.slug];
      const phone = PHONES[spot.slug];
      return (
        <Spot spot={spot} index={i + 1} total={home.spots.length} flip={i % 2 === 1}>
          {phone ? <PhoneShowcase {...phone} /> : <Visual />}
        </Spot>
      );
    })}

    <!-- ── Editores de datos: iPlist · iJson · iCSV · iXML ── -->
    <section class="section trio" id="nuevas" data-accent="#00e6b0">
      <div class="section-head reveal">
        <p class="eyebrow">Nuevo · Editores de datos</p>
        <h2 class="section-title">Plist, JSON, CSV y XML.<br><span class="muted">Fieles hasta el último byte.</span></h2>
        <p class="spot-desc">{editorsDesc}</p>
      </div>

      <div class="tabs reveal" role="tablist" aria-label="Editores de datos">
        {home.editors.map((e, i) => (
          <button class:list={['tab', { active: i === 0 }]} role="tab" id={`tab-${e.slug}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={e.slug}
                  data-tab={e.slug} style={`--c1:${e.tab.c1};--c2:${e.tab.c2}`} tabindex={i === 0 ? undefined : -1}>
            <AppIcon app={getApp(e.slug)} /><span>{getApp(e.slug).name}</span><i class="tab-progress"></i>
          </button>
        ))}
      </div>

      {home.editors.map((e, i) => {
        const Visual = VISUALS[e.slug];
        return <Spot spot={e} panel active={i === 0}><Visual /></Spot>;
      })}
    </section>

    <!-- ── Academia ── -->
    <section class="section" id="academia" data-accent="#3776ab">
      <div class="academy tilt-soft reveal">
        <div class="academy-copy">
          <p class="eyebrow eyebrow--py">ierwinx Academia</p>
          <h2 class="section-title">Curso de Python.<br><span class="muted">De cero a producción.</span></h2>
          <p class="spot-desc">Gratis y en español. Una idea por lección, de cinco a quince minutos, con ejemplos para copiar, ejecutar y romper. Hasta las cuatro cosas que la gente construye de verdad con Python.</p>
          <ol class="modules">{MODULES.map((m, i) => <li><span>{i}</span>{m}</li>)}</ol>
          <a class="btn btn--py magnetic" href="/python/">Empezar el curso gratis →</a>
        </div>
        <CodeWindow />
      </div>
    </section>

    <!-- ── Experiencia ── -->
    <section class="section" data-accent="#7c5cff">
      <p class="trusted reveal">Experiencia construyendo para</p>
      <div class="marquee marquee--logos">
        <div class="marquee-track marquee-track--slow">
          {CLIENTS.map((c) => <span>{c}</span>)}{CLIENTS.map((c) => <span aria-hidden="true">{c}</span>)}
        </div>
      </div>
    </section>

    <!-- ── Llamado final ── -->
    <section class="final">
      <h2 class="final-title reveal">Lleva la suite<br><span class="gradient-text">a tu Mac.</span></h2>
      <p class="spot-desc reveal">Nativa, ligera y sin rastreo. Elige por dónde empezar.</p>
      <div class="dock reveal" id="dock">
        {all.map((app) => <a href={`/${app.slug}/`} data-label={app.name}><AppIcon app={app} alt={app.name} /></a>)}
        <a href="/python/" data-label="Python" class="dock-py"><PythonLogo /></a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-brand">
      <BrandMark class="brand-mark" />
      <span>ierwinx</span>
    </div>
    <nav class="footer-links" aria-label="Productos">
      {all.map((app) => <a href={`/${app.slug}/`}>{app.name}</a>)}<a href="/python/">Python</a>
    </nav>
    <p>© {new Date().getFullYear()} ierwinx · Hecho a mano en Ciudad de México · <a href="/contacto/">Contacto</a> · <a class="footer-creator" href="/CV/">Conoce al creador</a></p>
  </footer>

  <script>import '../scripts/pages/home';</script>
</BaseLayout>
