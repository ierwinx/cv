---
// Soporte — Super Pets. La estructura común está en SuperpetsShell.
import SuperpetsShell from '../../components/superpets/SuperpetsShell.astro';
import ContactForm from '../../components/ui/ContactForm.astro';
import Faq from '../../components/sections/Faq.astro';

const FAQ: [string, string][] = [
  ['¿Cómo agrego una mascota?', '<p>Ve a la pestaña "Mascotas" y toca el botón "+" en la esquina superior. Completa el nombre, tipo, raza, género y opcionalmente la fecha de nacimiento, peso y foto.</p>'],
  ['¿Cómo registro una vacuna o desparasitación?', '<p>Entra al perfil de tu mascota, toca "Cartilla" y luego el botón "+". Puedes elegir entre vacuna o desparasitación. Agrega la fecha, foto del comprobante, firma del veterinario y la fecha de la próxima cita.</p>'],
  ['¿Cómo sé cuándo le toca la próxima vacuna?', '<p>En la pantalla de Inicio verás la sección "Próxima visita al veterinario" con las citas más cercanas. También puedes activar notificaciones para recibir un recordatorio automático.</p>'],
  ['¿Cómo funcionan las recetas médicas?', '<p>En la pestaña "Recetas" puedes registrar medicamentos con su dosis, frecuencia y duración. Si activas las notificaciones, recibirás alertas en cada hora de toma. El modo "estricto" notifica incluso de madrugada.</p>'],
  ['¿Para qué sirve el mapa?', '<p>En la pestaña "Mapas" puedes encontrar veterinarias, parques para perros, tiendas de mascotas, guarderías, restaurantes y cafeterías pet-friendly cercanos a tu ubicación.</p>'],
  ['¿Puedo tener varias mascotas?', '<p>Sí, puedes agregar tantas mascotas como necesites. Cada una tiene su propio perfil con fotos, cartilla de vacunación y toda su información independiente.</p>'],
  ['¿Mis datos están seguros?', '<p>Toda la información se guarda localmente en tu dispositivo y se sincroniza con tu iCloud personal (si lo tienes habilitado). Tu contraseña se almacena cifrada en el Keychain de iOS. Solo los comentarios que envías voluntariamente llegan a nuestros servidores.</p>'],
  ['¿Cómo activo Face ID o Touch ID?', '<p>Ve a Configuración &rarr; Permisos y activa la opción biométrica. Una vez activado, verás el botón correspondiente en la pantalla de inicio de sesión.</p>'],
  ['¿Qué hago si olvidé mi contraseña?', '<p>En la pantalla de inicio de sesión toca "¿Olvidaste tu contraseña?" y sigue los pasos para restablecerla usando tu nombre de usuario o correo electrónico.</p>'],
  ['¿Cómo cambio el tema de la app?', '<p>Ve a Configuración &rarr; Temas. Encontrarás 37 temas en secciones adaptables, claros, oscuros y especiales con degradados. Los adaptables cambian automáticamente con el modo claro/oscuro de tu iPhone. Toca el que más te guste y se aplicará al instante.</p>'],
  ['¿Cómo elimino una mascota?', '<p>Entra al perfil de la mascota desde la lista, desplázate hasta el final y encontrarás la opción para eliminarla. Ten en cuenta que esta acción eliminará también todas sus vacunas registradas.</p>'],
  ['¿Para qué sirve el Clicker?', '<p>El Clicker te ayuda a entrenar a tu mascota con refuerzo positivo: toca el botón justo cuando haga algo bien y dale un premio. Click + premio = aprendizaje rápido. Puedes elegir el sonido del clicker.</p>'],
  ['¿Cómo calculo la edad humana de mi mascota?', '<p>En la pantalla de Inicio toca "Calculadora de edad humana". Elige el tipo de mascota y su fecha de nacimiento; en perros también puedes indicar la raza o el tamaño y el peso. Verás su edad en años humanos y su esperanza de vida.</p>'],
  ['¿Cómo vinculo mi cuenta con Apple?', '<p>Ve a Configuración &rarr; Perfil y toca "Vincular con Apple". Así podrás iniciar sesión más rápido si reinstalas la app, sin perder ningún dato.</p>'],
  ['¿Cómo funciona el Apple Watch?', '<p>La app de Apple Watch muestra un resumen de tus mascotas y sus próximas visitas al veterinario. Los datos se sincronizan automáticamente desde tu iPhone.</p>'],
];
---
<SuperpetsShell variant="legal" title="Soporte — Super Pets"
                 description="Centro de soporte de Super Pets. Encuentra respuestas a tus preguntas o contáctanos.">
<main class="support">
    <h1>Centro de Soporte</h1>
    <p class="subtitle">Estamos aquí para ayudarte. Encuentra respuestas a las preguntas más comunes o contáctanos directamente.</p>

    <!-- ── Contacto ──────────────────────── -->
    <div class="support-card">
        <h3>Contacto directo</h3>
        <p>Si necesitas ayuda personalizada, usa el <a href="#contacto">formulario de contacto</a> o la sección de Comentarios dentro de la app (Configuración &rarr; Comentarios).</p>
    </div>

    <div class="support-card">
        <h3>Requisitos del sistema</h3>
        <p>Super Pets requiere iOS 17.6 o superior. Compatible con iPhone y iPad. Funciones adicionales disponibles para Apple Watch (watchOS 10.6+), widgets de pantalla de inicio, Centro de control y Live Activities en la Dynamic Island.</p>
    </div>

    <!-- ── FAQ ────────────────────────────── -->
    <h2 style="margin-top: 48px; margin-bottom: 24px;">Preguntas frecuentes</h2>

    <Faq items={FAQ} />

    <!-- ── Más ayuda ──────────────────────── -->
    <div class="support-card support-card--form" id="contacto" style="margin-top: 48px;">
        <h3>¿No encontraste lo que buscas?</h3>
        <p>Cuéntanos tu problema y te responderemos lo antes posible.</p>
        <ContactForm origen="superpets" placeholder="Describe tu problema: modelo de iPhone, versión de iOS y qué estabas haciendo." />
    </div>
</main>
</SuperpetsShell>
