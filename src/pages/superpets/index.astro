---
// Portada de Super Pets. La estructura (fondo, nav, footer, script) está en SuperpetsShell.
import SuperpetsShell from '../../components/superpets/SuperpetsShell.astro';
import Button from '../../components/ui/Button.astro';
import DownloadCta from '../../components/sections/DownloadCta.astro';
import Faq from '../../components/sections/Faq.astro';
import { FAQ } from '../../components/superpets/faq';
import { getApp } from '../../lib/apps';
import Icon from '../../components/ui/Icon.astro';

const app = getApp('superpets');
const install = app.install!;
// Capturas (public/superpets/img/fotoN.webp): tamaño real, para width/height. Se declaran una vez y alimentan el
// teléfono del hero, el recorrido y la galería.
const SHOTS: Record<string, [number, number]> = {
  foto1: [800, 1739],
  foto2: [460, 996],
  foto3: [800, 1739],
  foto4: [800, 1739],
  foto5: [800, 1739],
  foto6: [800, 1739],
  foto7: [800, 1739],
  foto8: [800, 1739],
  foto9: [800, 1739],
  foto10: [460, 996],
  foto11: [460, 996],
  foto12: [460, 996],
};
const TOUR = [
  { shot: 'foto2', alt: 'Lista de mascotas', title: 'Toda tu manada', text: 'Agrega tantas mascotas como necesites. Cada una tiene su propio perfil con fotos, cartilla de vacunación y toda su información independiente.' },
  { shot: 'foto3', alt: 'Editar mascota', title: 'Perfiles a detalle', text: 'Tipo, raza, fecha de nacimiento, peso y foto. Todo lo importante de cada compañero en un solo perfil.' },
  { shot: 'foto4', alt: 'Recetas médicas', title: 'Ninguna toma olvidada', text: 'Registra medicamentos con su dosis, frecuencia y duración. El modo estricto te avisa incluso de madrugada.' },
  { shot: 'foto6', alt: 'Mapa de servicios', title: 'El mundo pet-friendly', text: 'Parques, veterinarias, hospitales, entrenadores, guarderías, tiendas, restaurantes y cafeterías cerca de ti.' },
  { shot: 'foto11', alt: 'Gráficas de paseos', title: 'Cada paseo cuenta', text: 'Gráficas semanales de duración y distancia por día para ver cuánto caminan tus perros, con el total de paseos, minutos y kilómetros de la semana.' },
  { shot: 'foto12', alt: 'Clicker de entrenamiento', title: 'Entrena como se debe', text: 'Un clicker de entrenamiento siempre a la mano. Úsalo justo cuando tu mascota haga algo bien: click + premio = aprendizaje rápido.' },
  { shot: 'foto7', alt: 'Temas', title: 'Hazla tuya', text: '37 temas personalizables: adaptables, claros, oscuros y especiales con degradados. Del clásico Nebular a Aurora, Océano o Galaxia.' },
  { shot: 'foto10', alt: 'Logros', title: 'Cuidar también se gana', text: 'Desbloquea 22 logros mientras cuidas a tu mascota y suma puntos hasta llegar a los 1,000.' },
];
const GALLERY: [shot: string, alt: string, caption: string][] = [
  ['foto9', 'Inicio de sesión', 'Inicio de sesión'],
  ['foto1', 'Inicio', 'Inicio'],
  ['foto2', 'Mascotas', 'Mascotas'],
  ['foto3', 'Detalle de mascota', 'Detalle de mascota'],
  ['foto4', 'Recetas', 'Recetas'],
  ['foto5', 'Editar receta', 'Editar receta'],
  ['foto6', 'Mapas', 'Mapas'],
  ['foto11', 'Gráficas de paseos', 'Gráficas de paseos'],
  ['foto12', 'Clicker', 'Clicker'],
  ['foto7', 'Temas', 'Temas'],
  ['foto8', 'Perfil', 'Perfil'],
  ['foto10', 'Logros', 'Logros'],
];
---
<SuperpetsShell variant="home">
<!-- ── HERO ────────────────────────────── -->
<header class="hero" id="contenido">
    <div class="hero-inner">
        <div class="hero-copy">
            <span class="hero-badge reveal"><span class="pulse-dot"></span> Nueva versión 1.3 · Disponible en App Store</span>
            <h1 class="hero-title split">Todo el cuidado de tus mascotas en <em class="gradient-text">un solo lugar</em></h1>
            <p class="hero-lead reveal" style="--d:.35s">Vacunas, recetas, cumpleaños, veterinarias cercanas y mucho más. Super Pets te ayuda a ser el mejor dueño para tus compañeros peludos.</p>
            <div class="hero-actions reveal" style="--d:.5s">
                <Button href={install} ring external>
                    <Icon name="apple" />
                    <span class="store-label"><small>Descárgala en el</small>App Store</span>
                </Button>
                <Button href="#features" variant="ghost">Explorar funciones <span aria-hidden="true">→</span></Button>
            </div>
            <ul class="hero-platforms reveal" style="--d:.65s" aria-label="Plataformas">
                <li>iPhone</li><li>iPad</li><li>Mac</li><li>Apple Watch</li><li>CarPlay</li>
            </ul>
        </div>

        <div class="hero-stage" id="heroStage">
            <div class="orbit orbit--1" aria-hidden="true"></div>
            <div class="orbit orbit--2" aria-hidden="true"></div>
            <div class="phone phone--back phone--left" data-depth="0.5">
                <img src="img/foto2.webp" width="460" height="996" alt="Lista de mascotas" decoding="async">
            </div>
            <div class="phone phone--back phone--right" data-depth="0.5">
                <img src="img/foto10.webp" width="460" height="996" alt="Sistema de logros" decoding="async">
            </div>
            <div class="phone phone--front" data-depth="1">
                <img src="img/foto1.webp" width="800" height="1739" alt="Pantalla de inicio celebrando un cumpleaños" decoding="async">
            </div>
            <div class="chip chip--1" data-depth="1.6"><span>💉</span><div><b>Vacuna antirrábica</b><small>Mañana · 10:00</small></div></div>
            <div class="chip chip--2" data-depth="1.9"><span>🎂</span><div><b>¡Caramelo cumple 8!</b><small>Hoy</small></div></div>
            <div class="chip chip--3" data-depth="1.3"><span>🏆</span><div><b>+25 puntos</b><small>Perfil completo</small></div></div>
        </div>
    </div>
    <a href="#features" class="scroll-hint" aria-label="Bajar"><span></span></a>
</header>

<!-- ── STATS ───────────────────────────── -->
<section class="stats">
    <div class="stats-inner">
        <div class="stat reveal"><b data-count="14">0</b><span>funciones esenciales</span></div>
        <div class="stat reveal" style="--d:.1s"><b data-count="37">0</b><span>temas personalizables</span></div>
        <div class="stat reveal" style="--d:.2s"><b data-count="6">0</b><span>experiencias Apple</span></div>
        <div class="stat reveal" style="--d:.3s"><b data-count="1000" data-format="es">0</b><span>puntos por desbloquear</span></div>
    </div>
</section>

<!-- ── FEATURES (BENTO) ────────────────── -->
<section class="features" id="features">
    <div class="section-inner">
        <div class="section-title reveal">
            <span class="eyebrow">Funciones</span>
            <h2>Todo lo que <em class="gradient-text">necesitas</em></h2>
            <p>Gestiona la salud y bienestar de todas tus mascotas desde una sola app.</p>
        </div>

        <div class="bento">
            <article class="card card--wide card--profiles reveal">
                <div class="card-icon">🐶</div>
                <h3>Perfiles completos</h3>
                <p>Registra nombre, raza, peso, fecha de nacimiento, foto y documento RUAC de cada mascota. Soporta perros, gatos, aves, conejos, hámsters, peces, tortugas y más, con más de 50 razas.</p>
                <div class="pet-pills" aria-hidden="true">
                    <span>🐕 Perro</span><span>🐈 Gato</span><span>🦜 Ave</span><span>🐇 Conejo</span><span>🐹 Hámster</span><span>🐠 Pez</span><span>🐢 Tortuga</span>
                </div>
            </article>

            <article class="card card--tall card--vaccine reveal" style="--d:.1s">
                <div class="card-icon">💉</div>
                <h3>Cartilla de vacunación</h3>
                <p>Lleva el registro de vacunas y desparasitaciones con fotos, firma del veterinario y recordatorios automáticos para la próxima cita.</p>
                <div class="ring" aria-hidden="true">
                    <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="50" class="ring-bg"/><circle cx="60" cy="60" r="50" class="ring-fg"/></svg>
                    <div class="ring-label"><b>4/5</b><small>al día</small></div>
                </div>
            </article>

            <article class="card card--rx reveal" style="--d:.15s">
                <div class="card-icon">💊</div>
                <h3>Recetas médicas</h3>
                <p>Controla medicamentos con dosis, frecuencia y duración. Recibe notificaciones puntuales para no olvidar ninguna toma.</p>
                <div class="notif" aria-hidden="true"><img src="img/app-icon.webp" width="512" height="512" alt=""><div><b>Gotas Oídos</b><small>Es hora de la toma · 30 ml</small></div><time>ahora</time></div>
            </article>

            <article class="card card--map reveal" style="--d:.2s">
                <div class="card-icon">🗺️</div>
                <h3>Mapa de servicios</h3>
                <p>Encuentra veterinarias, parques, tiendas de mascotas, guarderías y cafeterías pet-friendly cerca de ti.</p>
                <div class="map-pins" aria-hidden="true"><i style="--x:18%;--y:40%"><b>🏥</b></i><i style="--x:52%;--y:22%"><b>🌳</b></i><i style="--x:78%;--y:55%"><b>☕</b></i><i style="--x:38%;--y:70%"><b>🛍️</b></i></div>
            </article>

            <article class="card card--birthday reveal" style="--d:.1s">
                <div class="card-icon">🎂</div>
                <h3>Cumpleaños y alertas</h3>
                <p>Nunca olvides el cumpleaños de tu mascota. Celebra con animaciones especiales y recibe recordatorios anticipados.</p>
                <div class="confetti-mini" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
            </article>

            <article class="card card--wide card--walk reveal" style="--d:.15s">
                <div class="card-icon">🚶</div>
                <h3>Paseos</h3>
                <p>Registra paseos con GPS en tiempo real o de forma manual. Ve la ruta en el mapa, duración y distancia recorrida. Mantén tu racha de días seguidos, revisa tu semana con gráficas de duración y distancia, y descubre la intensidad de cada paseo. Comparte una imagen diseñada de tu paseo en redes sociales.</p>
                <svg class="route" viewBox="0 0 400 120" aria-hidden="true">
                    <path class="route-path" d="M10 95 C 60 20, 110 110, 160 60 S 250 10, 290 70 S 360 100, 390 30"/>
                    <circle class="route-dot" r="7"/>
                </svg>
                <div class="walk-stats" aria-hidden="true"><span><b>2.4</b> km</span><span><b>32</b> min</span><span><b>🐾</b> Caramelo</span><span><b>🔥 5</b> días seguidos</span></div>
            </article>

            <article class="card card--live reveal" style="--d:.2s">
                <div class="card-icon">🟢</div>
                <h3>Live Activities y Dynamic Island</h3>
                <p>Tu paseo sigue activo aunque cierres la app. Visualiza el tiempo y la distancia en tiempo real desde la Dynamic Island o la pantalla de bloqueo.</p>
                <div class="island" aria-hidden="true"><span class="island-icon">🐕</span><span class="island-time">12:48</span><span class="island-dist">1.2 km</span></div>
            </article>

            <article class="card card--passport reveal">
                <div class="card-icon">📄</div>
                <h3>Pasaporte PDF</h3>
                <p>Genera un pasaporte digital con toda la información de tu mascota: datos, historial de vacunas, desparasitaciones y RUAC. Listo para compartir con tu veterinario.</p>
                <div class="doc" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            </article>

            <article class="card card--clicker reveal">
                <div class="card-icon">🔔</div>
                <h3>Clicker de entrenamiento</h3>
                <p>Premia el buen comportamiento al instante. Click + premio = aprendizaje rápido, con varios sonidos para elegir.</p>
                <div class="clicker" aria-hidden="true"><span class="clicker-btn">click!</span></div>
            </article>

            <article class="card card--age reveal" style="--d:.1s">
                <div class="card-icon">🧮</div>
                <h3>Edad humana</h3>
                <p>Calcula la edad de tu mascota en años humanos según su especie, raza o tamaño y peso, con su esperanza de vida. Nada de multiplicar por 7.</p>
                <div class="age" aria-hidden="true"><span>🐶</span><i>→</i><span>👤</span></div>
            </article>

            <article class="card card--timeline reveal" style="--d:.15s">
                <div class="card-icon">🕰️</div>
                <h3>Línea de tiempo</h3>
                <p>Revive la historia de cada mascota: su nacimiento, cumpleaños, vacunas, desparasitaciones, su primer paseo y el más largo.</p>
                <ol class="mini-timeline" aria-hidden="true"><li>Nació</li><li>Primera vacuna</li><li>Primer paseo</li></ol>
            </article>

            <article class="card card--moments reveal" style="--d:.2s">
                <div class="card-icon">📸</div>
                <h3>Momentos para compartir</h3>
                <p>Tarjetas listas para tus historias: cumpleaños, primer paseo, kilómetros acumulados, aniversarios juntos y vacunas al día. Elige entre diseños elegante, con foto o colorido.</p>
                <div class="moments" aria-hidden="true"><span>🎉🎂🎈</span><span>🐾🎉✨</span><span>❤️🐾🏠</span></div>
            </article>

            <article class="card card--wide card--devices reveal" style="--d:.1s">
                <div class="card-icon">⌚</div>
                <h3>En todos tus dispositivos Apple</h3>
                <p>Disponible en iPhone, iPad y Mac. Con widgets de Mis Mascotas y de Paseos, acceso desde el Centro de control y la pantalla bloqueada, companion para Apple Watch y widgets visibles desde CarPlay — tus mascotas siempre al alcance.</p>
                <div class="device-row" aria-hidden="true">
                    <span><i>📱</i>iPhone</span><span><i>📲</i>iPad</span><span><i>💻</i>Mac</span><span><i>⌚</i>Watch</span><span><i>🚗</i>CarPlay</span><span><i>🧩</i>Widget</span>
                </div>
            </article>

            <article class="card card--trophy reveal" style="--d:.2s">
                <div class="card-icon">🏆</div>
                <h3>Sistema de logros</h3>
                <p>Desbloquea 22 logros mientras cuidas a tu mascota. Registra vacunas, celebra cumpleaños, explora el mapa, completa paseos y más. ¿Puedes llegar a los 1,000 puntos?</p>
                <div class="xp" aria-hidden="true"><div class="xp-bar"><span></span></div><small><b data-count="1000" data-format="es">0</b> / 1,000 pts</small></div>
            </article>
        </div>
    </div>
</section>

<!-- ── TOUR (STICKY PHONE) ─────────────── -->
<section class="tour" id="tour">
    <div class="section-inner">
        <div class="section-title reveal">
            <span class="eyebrow">Recorrido</span>
            <h2>Una app pensada <em class="gradient-text">para ellos</em></h2>
            <p>Desliza y descubre cómo se ve Super Pets en tu día a día.</p>
        </div>

        <div class="tour-grid">
            <div class="tour-sticky">
                <div class="phone phone--tour">
                    {TOUR.map((t, i) => <img class:list={['tour-screen', { 'is-active': i === 0 }]} src={`img/${t.shot}.webp`} width={SHOTS[t.shot][0]} height={SHOTS[t.shot][1]} alt={t.alt} loading="lazy" decoding="async">)}
                </div>
                <div class="tour-glow" aria-hidden="true"></div>
            </div>

            <ol class="tour-steps">
                {TOUR.map((t, i) => (
                    <li class="tour-step" data-step={i}>
                        <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                        <h3>{t.title}</h3>
                        <p>{t.text}</p>
                        <img class="step-shot" src={`img/${t.shot}.webp`} width={SHOTS[t.shot][0]} height={SHOTS[t.shot][1]} alt="" loading="lazy" decoding="async">
                    </li>
                ))}
            </ol>
        </div>
    </div>
</section>

<!-- ── SCREENSHOTS (COVERFLOW) ─────────── -->
<section class="screenshots" id="screenshots">
    <div class="section-inner">
        <div class="section-title reveal">
            <span class="eyebrow">Capturas</span>
            <h2>Diseñada con <em class="gradient-text">amor</em></h2>
            <p>Una interfaz intuitiva con 37 temas personalizables y soporte para modo claro y oscuro.</p>
        </div>
    </div>

    <div class="gallery reveal">
        <button class="gallery-btn gallery-btn--prev" aria-label="Anterior">←</button>
        <div class="gallery-track" id="galleryTrack">
            {GALLERY.map(([shot, alt, caption]) => (
                <figure class="shot"><div class="phone"><img src={`img/${shot}.webp`} width={SHOTS[shot][0]} height={SHOTS[shot][1]} alt={alt} loading="lazy" decoding="async"></div><figcaption>{caption}</figcaption></figure>
            ))}
        </div>
        <button class="gallery-btn gallery-btn--next" aria-label="Siguiente">→</button>
    </div>
</section>

<!-- ── PREGUNTAS ───────────────────────── -->
<section class="tour" id="preguntas">
    <div class="section-inner">
        <div class="section-title reveal">
            <span class="eyebrow">Preguntas</span>
            <h2>Lo que más <em class="gradient-text">se pregunta</em></h2>
            <p>¿Tienes otra duda? Todas las respuestas están en el <a href="support.html">centro de soporte</a>.</p>
        </div>
        <Faq items={FAQ.slice(0, 6)} />
    </div>
</section>

<!-- ── CTA ─────────────────────────────── -->
<DownloadCta app={app} id="ctaCard" icon="img/app-icon.webp" title="Descarga Super Pets" accent="gratis"
             sub="Disponible para iPhone y iPad. Compatible con Apple Watch, Widget y sincronización automática con iCloud.">
    <div slot="bg">
        <canvas class="cta-confetti" id="ctaConfetti"></canvas>
        <span class="float-pet float-pet--1">🐶</span>
        <span class="float-pet float-pet--2">🐱</span>
        <span class="float-pet float-pet--3">🐰</span>
        <span class="float-pet float-pet--4">🦜</span>
    </div>
    <Button href={install} size="lg" ring external>
        <Icon name="apple" />
        <span class="store-label"><small>Descárgala en el</small>App Store</span>
    </Button>
    <Button href="support.html" variant="ghost" size="lg">Soporte</Button>
</DownloadCta>

<!-- ── LIGHTBOX de la galería ──────────── -->
<div class="lightbox" id="lightbox" hidden>
    <button class="lightbox-close" aria-label="Cerrar">✕</button>
    <div class="phone phone--lightbox"><img id="lightboxImg" src="" alt=""></div>
</div>
</SuperpetsShell>
