---
// iRar: diseño propio (Space Grotesk, ámbar sobre violeta). Estilos en styles/pages/irar.css, comportamiento en scripts/pages/irar.ts.
import AppPage from '../../layouts/AppPage.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';
import Button from '../../components/ui/Button.astro';
import DownloadButton from '../../components/ui/DownloadButton.astro';
import GlyphField from '../../components/ui/GlyphField.astro';
import DownloadCta from '../../components/sections/DownloadCta.astro';
import { getApp } from '../../lib/apps';
import '../../styles/pages/irar.css';
import Grain from '../../components/ui/Grain.astro';
import Icon from '../../components/ui/Icon.astro';
import Faq from '../../components/sections/Faq.astro';
import { getLegal } from '../../lib/legal';

const app = getApp('irar');

// Íconos de la demo: dibujos en SVG de los SF Symbols que usa la ventana real de iRar (ContentView.swift)
const SF = {
  archivebox: '<path d="M3.5 5.5h17v4h-17zM5 9.5V19a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 19 19V9.5M10 13.5h4"/>',
  grid: '<rect x="4" y="4" width="7" height="7" rx="1.6"/><rect x="13" y="4" width="7" height="7" rx="1.6"/><rect x="4" y="13" width="7" height="7" rx="1.6"/><rect x="13" y="13" width="7" height="7" rx="1.6"/>',
  create: '<rect x="8" y="8" width="12.5" height="12.5" rx="2.2"/><path d="M4 15.5V6a2.2 2.2 0 0 1 2.2-2.2h9.3M14.25 11.5v5.5M11.5 14.25H17"/>',
  waveform: '<path d="M2.5 12h2.8l2.2-5.5 3.2 11 3.1-13 3 15 2-7.5h2.7"/>',
  zipper: '<path d="M6.5 3h7.5l4.5 4.5V20a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4.5h4.5M10 5.5h1.5M10.5 8h1.5M10 10.5h1.5M10.5 13h1.5M10 15.5h1.5"/>',
  seal: '<path d="M12 2.8l2.1 1.6 2.6-.3 1 2.4 2.4 1-.3 2.6 1.6 2.1-1.6 2.1.3 2.6-2.4 1-1 2.4-2.6-.3L12 21.2l-2.1-1.6-2.6.3-1-2.4-2.4-1 .3-2.6L2.6 12l1.6-2.1-.3-2.6 2.4-1 1-2.4 2.6.3z" fill="currentColor" stroke="none"/><path d="M8.5 12.2l2.4 2.4 4.6-5" stroke="#1d1d1f"/>',
  desktop: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M9 20h6M12 16v4"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/>',
  moon: '<path d="M20 14.6A8.2 8.2 0 1 1 9.4 4a6.6 6.6 0 0 0 10.6 10.6z"/>',
  folder: '<path d="M3 6.5A2 2 0 0 1 5 4.5h4.2l2 2.2H19a2 2 0 0 1 2 2V17.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  addDoc: '<path d="M13 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h5M13 3l5 5v3.5M13 3v5h5M17.5 15v6M14.5 18h6"/>',
  extract: '<path d="M12 3.5v12M7 10.5l5 5 5-5M5 20.5h14"/>',
  sidebarRight: '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M15 4.5v15"/>',
  house: '<path d="M3.5 11 12 4l8.5 7M6 9.2V20h4.5v-5.5h3V20H18V9.2"/>',
  search: '<circle cx="10.5" cy="10.5" r="6"/><path d="M20 20l-5-5"/>',
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="2.2" fill="currentColor" stroke="none"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12.3l2.8 2.8L16.2 9"/>',
};
---
<AppPage slug="irar" htmlClass="no-js">
<script is:inline slot="head">document.documentElement.classList.replace("no-js", "js")</script>
  <div class="progress" aria-hidden="true"><span></span></div>
  <canvas id="aurora" aria-hidden="true"></canvas>
  <Grain z={-1} inset="-50%" move={['-3%, 2%', '2%, -4%', '-4%, -1%', '3%, 3%']} />
  <div class="cursor-glow" aria-hidden="true"></div>

  <GlyphField app={app} />

  <Nav app={app} home="#inicio" links={[['#magia', 'Cómo funciona'], ['#formatos', 'Formatos'], ['#velocidad', 'Velocidad'], ['#dev', 'Desarrolladores'], ['#privacidad', 'Privacidad']]}>
    <img slot="logo" src="assets/icono-256.png" alt="" width="36" height="36">
  </Nav>

  <main id="contenido">
    <!-- HERO -->
    <section id="inicio" class="hero">
      <div class="hero-copy">
        <p class="eyebrow reveal"><span class="dot"></span> Nativo para macOS · Swift 6 · Apple Silicon</p>
        <h1 class="reveal"><span class="sr-only">{app.name}: </span>
          <span class="line">Comprime el mundo.</span>
          <span class="line gradient-text">Ábrelo todo.</span>
        </h1>
        <p class="lead reveal">ZIP, RAR, 7z, TAR, GZIP, BZIP2, XZ y Zstandard. Edita JAR y AAR sin extraerlos.
          Contraseñas AES-256, archivos en partes y verificación de cada byte. Todo en tu Mac, sin nubes ni esperas.</p>
        <div class="hero-actions reveal">
          <Button href="#descargar">
            <Icon name="apple" />
            Descargar para Mac
          </Button>
        </div>
        <ul class="hero-stats reveal">
          <li><b data-count="14">0</b><span>formatos</span></li>
          <li><b data-count="134" data-suffix="×">0</b><span>más rápido con ZSTD que XZ</span></li>
          <li><b data-count="100" data-suffix=" %">0</b><span>local y privado</span></li>
        </ul>
      </div>

      <div class="hero-stage" aria-hidden="true">
        <div class="orbit orbit-a">
          <img src="assets/doc-zip.png" alt=""><img src="assets/doc-rar.png" alt=""><img src="assets/doc-7z.png" alt="">
        </div>
        <div class="orbit orbit-b">
          <img src="assets/doc-tar.png" alt=""><img src="assets/doc-gz.png" alt=""><img src="assets/doc-zst.png" alt="">
        </div>
        <div class="icon-card tilt">
          <div class="halo"></div>
          <img src="assets/icono-256.png" alt="Icono de iRar">
        </div>
      </div>
      <a class="scroll-hint" href="#magia" aria-label="Seguir bajando"><span></span></a>
    </section>

    <!-- MAGIC DEMO -->
    <section id="magia" class="section magic">
      <header class="section-head reveal">
        <p class="kicker">Cómo funciona</p>
        <h2>Explora sin extraer.<br><span class="gradient-text">Edita sin miedo.</span></h2>
        <p>iRar abre el archivo, te muestra su interior al instante y solo toca el original cuando el resultado ya está verificado.</p>
      </header>

      <!-- La ventana real de iRar (ContentView.swift): barra lateral, explorador con su tabla e inspector -->
      <div class="mac reveal" id="demo" aria-label="Demostración: iRar explorando Proyecto-final.7z">
        <aside class="mac-side">
          <div class="mac-lights" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="mac-brand">
            <span class="mac-logo"><svg viewBox="0 0 24 24" set:html={SF.archivebox} /></span>
            <div><b>iRar</b><small>Todo en su lugar.</small></div>
          </div>
          <p class="mac-sec">ESPACIO DE TRABAJO</p>
          <span class="mac-item"><svg viewBox="0 0 24 24" set:html={SF.grid} />Inicio</span>
          <span class="mac-item"><svg viewBox="0 0 24 24" set:html={SF.create} />Crear archivo</span>
          <span class="mac-item on"><svg viewBox="0 0 24 24" set:html={SF.archivebox} />Explorar</span>
          <span class="mac-item"><svg viewBox="0 0 24 24" set:html={SF.waveform} />Operaciones</span>
          <p class="mac-sec">RECIENTES</p>
          <span class="mac-item"><svg viewBox="0 0 24 24" set:html={SF.zipper} />Fotos.tar.zst</span>
          <span class="mac-item"><svg viewBox="0 0 24 24" set:html={SF.zipper} />app-release.jar</span>
          <span class="mac-item"><svg viewBox="0 0 24 24" set:html={SF.zipper} />Respaldo.rar</span>
          <div class="mac-side-foot">
            <span class="mac-default"><svg viewBox="0 0 24 24" set:html={SF.seal} />ZIP, RAR, 7z y TAR · Se abren con iRar</span>
            <span class="mac-seg" aria-hidden="true"><i class="on"><svg viewBox="0 0 24 24" set:html={SF.desktop} /></i><i><svg viewBox="0 0 24 24" set:html={SF.sun} /></i><i><svg viewBox="0 0 24 24" set:html={SF.moon} /></i></span>
          </div>
        </aside>

        <div class="mac-main">
          <div class="mac-toolbar">
            <b>Proyecto-final.7z</b>
            <span class="mac-tools" aria-hidden="true">
              <i><svg viewBox="0 0 24 24" set:html={SF.folder} /></i><i><svg viewBox="0 0 24 24" set:html={SF.plus} /></i><i id="demo-tool-add"><svg viewBox="0 0 24 24" set:html={SF.addDoc} /></i><i><svg viewBox="0 0 24 24" set:html={SF.extract} /></i><i class="on"><svg viewBox="0 0 24 24" set:html={SF.sidebarRight} /></i>
            </span>
          </div>
          <div class="mac-content">
            <div class="mac-explorer">
              <div class="mac-path">
                <svg viewBox="0 0 24 24" set:html={SF.house} /><span>Proyecto-final.7z</span>
                <span class="mac-search"><svg viewBox="0 0 24 24" set:html={SF.search} />Buscar en el archivo</span>
              </div>
              <div class="mac-table">
                <div class="mac-head"><span>Nombre</span><span>Tamaño</span><span>Comprimido</span></div>
                <div class="mac-rows" id="demo-rows"></div>
              </div>
              <div class="mac-foot"><span id="demo-foot">0 elementos</span><span class="mac-hint">Arrastra para añadir o extraer</span><span id="demo-total">0 MB sin comprimir</span></div>
            </div>
            <aside class="mac-insp">
              <div class="mac-insp-body">
                <p class="mac-sec">INFORMACIÓN</p>
                <div class="mac-insp-head">
                  <svg viewBox="0 0 24 24" id="demo-icon" set:html={SF.zipper} />
                  <b id="demo-name">Proyecto-final.7z</b><small id="demo-kind">Archivo 7z</small>
                </div>
                <dl>
                  <dt>Elementos</dt><dd id="demo-count">0</dd>
                  <dt>Tamaño original</dt><dd id="demo-size">0 MB</dd>
                  <dt class="sel">Selección</dt><dd class="sel" id="demo-sel">—</dd>
                  <dt class="sel">Comprimido</dt><dd class="sel" id="demo-comp">—</dd>
                </dl>
                <span class="mac-lock"><svg viewBox="0 0 24 24" set:html={SF.lock} />Protegido con contraseña</span>
              </div>
              <div class="mac-insp-foot">
                <span class="mac-btn" id="demo-extract"><svg viewBox="0 0 24 24" set:html={SF.extract} />Extraer todo…</span>
                <small>Usa el botón para extraer a una carpeta nueva, o arrastra los elementos directamente a Finder.</small>
              </div>
            </aside>
          </div>
          <div class="mac-status" id="demo-op">
            <span class="mac-spin" aria-hidden="true"></span>
            <svg class="mac-done" viewBox="0 0 24 24" aria-hidden="true" set:html={SF.check} />
            <div class="mac-status-text"><span id="demo-op-text">Listo. Tus archivos se procesan en este Mac.</span><div class="mac-bar"><i id="demo-bar"></i></div></div>
            <span class="mac-pct" id="demo-pct">0 %</span>
            <span class="mac-cancel">Cancelar</span>
          </div>
        </div>
        <div class="fly-layer" id="fly"></div>
      </div>

      <div class="steps">
        <div class="step reveal"><b>01</b><h3>Abre</h3><p>Doble clic, ⌘O o arrastra el archivo. Las partes y contraseñas se piden solo si hacen falta.</p></div>
        <div class="step reveal"><b>02</b><h3>Explora</h3><p>Navega carpetas, busca y previsualiza con ⌘Y sin descomprimir nada.</p></div>
        <div class="step reveal"><b>03</b><h3>Edita</h3><p>Añade, renombra o elimina. Trabaja en una copia privada y verifica antes de reemplazar.</p></div>
        <div class="step reveal"><b>04</b><h3>Extrae</h3><p>Todo o solo lo que arrastres a Finder. Si cancelas, no queda nada a medias.</p></div>
      </div>
    </section>

    <!-- FORMATS GRID -->
    <section class="section" id="formatos">
      <header class="section-head reveal">
        <p class="kicker">Un solo lugar</p>
        <h2>Catorce formatos.<br><span class="gradient-text">Una sola app.</span></h2>
        <p>Abre lo que te manden y crea lo que necesites. Cada formato con su motor oficial, integrado dentro de iRar.</p>
      </header>
      <div class="formats">
        <article class="format tilt reveal" data-glow>
          <img src="assets/doc-zip.png" alt=""><h3>ZIP</h3>
          <p>Crear, editar, AES-256, ZIP64 y partes <code>.z01</code>.</p>
          <ul class="caps"><li>Abrir</li><li>Crear</li><li>Editar</li><li>Contraseña</li><li>Partes</li></ul>
        </article>
        <article class="format tilt reveal" data-glow>
          <img src="assets/doc-rar.png" alt=""><h3>RAR</h3>
          <p>RAR4 y RAR5 con UnRAR oficial: explora y extrae, también con contraseña, nombres cifrados y en partes.</p>
          <ul class="caps"><li>Abrir</li><li>Crear</li><li>Extraer</li><li>Contraseña</li><li>Partes</li><li>Autoextraíbles</li></ul>
        </article>
        <article class="format tilt reveal" data-glow>
          <img src="assets/doc-7z.png" alt=""><h3>7z</h3>
          <p>7-Zip 26 integrado: LZMA2 multinúcleo, nombres cifrados, <code>.7z.001</code>.</p>
          <ul class="caps"><li>Abrir</li><li>Crear</li><li>Editar</li><li>Contraseña</li><li>Partes</li></ul>
        </article>
        <article class="format tilt reveal" data-glow>
          <img src="assets/doc-tar.png" alt=""><h3>TAR</h3>
          <p>Sin comprimir o con GZIP, BZIP2, XZ y Zstandard, en un solo paso.</p>
          <ul class="caps"><li>Abrir</li><li>Crear</li><li>Editar</li><li>4 compresiones</li></ul>
        </article>
        <article class="format tilt reveal" data-glow>
          <img src="assets/doc-zst.png" alt=""><h3>Zstandard</h3>
          <p>El compresor moderno de Meta, usando todos los núcleos de tu Mac.</p>
          <ul class="caps"><li>.tar.zst</li><li>.zst</li><li>Multinúcleo</li></ul>
        </article>
        <article class="format tilt reveal java" data-glow>
          <div class="java-badges"><b>JAR</b><b>AAR</b><b>WAR</b><b>EAR</b></div><h3>Java y Android</h3>
          <p>Edita paquetes sin extraerlos. APK y AAB, para inspeccionar sin romper su firma.</p>
          <ul class="caps"><li>Editar</li><li>Ofuscados</li><li>Firmados</li><li>APK solo lectura</li></ul>
        </article>
      </div>
      <p class="footnote reveal">RAR es un formato propietario: iRar lo lee con UnRAR oficial; para crear RAR usa usamos el programa RAR de RARLAB.</p>
    </section>

    <!-- BENTO -->
    <section class="section">
      <header class="section-head reveal">
        <p class="kicker">Hecho con obsesión</p>
        <h2>Pequeños detalles.<br><span class="gradient-text">Gran tranquilidad.</span></h2>
      </header>
      <div class="bento">
        <article class="tile tile-wide reveal" data-glow>
          <div class="tile-icon">🔐</div>
          <h3>AES-256 y nombres ocultos</h3>
          <p>En 7z también se cifra la lista de archivos: sin la contraseña no se ve ni qué hay dentro. iRar abre igual los RAR con nombres cifrados. Acepta «ñ» y acentos escritos desde cualquier teclado.</p>
          <div class="cipher" aria-hidden="true"><span>informe-final.pdf</span><span class="scramble" data-text="informe-final.pdf"></span></div>
        </article>
        <article class="tile reveal" data-glow>
          <div class="tile-icon">✂️</div><h3>En partes</h3>
          <p>Divide en 10 MB, 100 MB, 650 MB o 2 GB, y vuelve a unirlos con un clic.</p>
          <div class="parts" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        </article>
        <article class="tile reveal" data-glow>
          <div class="tile-icon">✅</div><h3>Verificado</h3>
          <p>Cada archivo creado se descomprime y se compara CRC32 contra el original antes de guardarse.</p>
        </article>
        <article class="tile reveal" data-glow>
          <div class="tile-icon">🧲</div><h3>Arrastra a Finder</h3>
          <p>Saca solo lo que necesitas, directamente al Escritorio o a cualquier carpeta.</p>
        </article>
        <article class="tile reveal" data-glow>
          <div class="tile-icon">🛑</div><h3>Cancela sin restos</h3>
          <p>Interrumpe cuando quieras: el destino queda limpio y el original intacto.</p>
        </article>
        <article class="tile tile-wide reveal" data-glow>
          <div class="tile-icon">🧱</div>
          <h3>Gigante, pero ligero</h3>
          <p>Archivos de más de 4 GiB y 65 536 entradas, leídos por bloques de 256 KiB: nunca se carga todo en memoria.</p>
          <div class="meter-row">
            <div class="meter"><span>Memoria al comprimir 256 MiB</span><div class="meter-bar"><i data-width="3.5"></i></div><b><em data-count="9.2" data-decimals="1">0</em> MiB</b></div>
            <div class="meter old"><span>Antes de optimizar</span><div class="meter-bar"><i data-width="100"></i></div><b>265.9 MiB</b></div>
          </div>
        </article>
      </div>
    </section>

    <!-- SPEED -->
    <section id="velocidad" class="section speed">
      <header class="section-head reveal">
        <p class="kicker">Velocidad real</p>
        <h2>Medido, no prometido.</h2>
        <p>Los mismos 256 MiB comprimidos en cada formato, uno por uno, en un Mac M1. Verificación incluida; mediana de 3 pasadas.</p>
      </header>
      <div class="race reveal" id="race">
        <div class="lane"><span class="name">TAR.ZST</span><div class="track"><i data-time="0.23"></i></div><b>0.23 s</b></div>
        <div class="lane"><span class="name">ZIP</span><div class="track"><i data-time="2.91"></i></div><b>2.91 s</b></div>
        <div class="lane"><span class="name">TAR.GZ</span><div class="track"><i data-time="2.91"></i></div><b>2.91 s</b></div>
        <div class="lane"><span class="name">7z</span><div class="track"><i data-time="3.94"></i></div><b>3.94 s</b></div>
        <div class="lane"><span class="name">RAR</span><div class="track"><i data-time="5.83"></i></div><b>5.83 s</b></div>
        <div class="lane"><span class="name">TAR.XZ</span><div class="track"><i data-time="30.8"></i></div><b>30.8 s</b></div>
        <div class="lane"><span class="name">TAR.BZ2</span><div class="track"><i data-time="45.9"></i></div><b>45.9 s</b></div>
        <button class="ui-btn ui-btn-ghost ui-btn-sm" id="race-again" type="button">↻ Repetir carrera</button>
      </div>
      <div class="numbers">
        <div class="number reveal"><b><em data-count="0.16" data-decimals="2">0</em> s</b><span>extraer 256 MiB de ZIP</span></div>
        <div class="number reveal"><b><em data-count="4" >0</em> GiB+</b><span>en un solo archivo, probado en USB exFAT</span></div>
        <div class="number reveal"><b><em data-count="65536">0</em></b><span>entradas en un archivo</span></div>
      </div>
    </section>

    <!-- DEV -->
    <section id="dev" class="section dev">
      <div class="dev-copy reveal">
        <p class="kicker">Para desarrolladores</p>
        <h2>Tu JAR, editado.<br><span class="gradient-text">Y sigue funcionando.</span></h2>
        <p>Abre un <code>.jar</code>, añade un recurso, renombra o elimina, y vuelve a ejecutarlo. iRar respeta las clases ofuscadas que solo cambian en mayúsculas (<code>a.class</code> y <code>A.class</code>) y te avisa antes de tocar un JAR firmado.</p>
        <ul class="checks">
          <li>JAR, AAR, WAR y EAR editables</li>
          <li>APK y AAB para inspeccionar sin romper su firma</li>
          <li>Doble clic en un JAR sigue abriendo Java: iRar aparece en «Abrir con»</li>
        </ul>
      </div>
      <div class="terminal reveal" id="terminal">
        <div class="window-bar"><i></i><i></i><i></i><span>zsh — ~/proyecto</span></div>
        <pre id="terminal-text" aria-label="Ejemplo de terminal"></pre>
      </div>
    </section>

    <!-- PRIVACY -->
    <section id="privacidad" class="section privacy">
      <div class="shield reveal" aria-hidden="true">
        <svg viewBox="0 0 120 140"><path d="M60 6 110 26v38c0 34-22 58-50 70C32 122 10 98 10 64V26z"/><path class="check" d="M38 70l15 15 30-32"/></svg>
      </div>
      <div class="privacy-copy reveal">
        <p class="kicker">Privacidad</p>
        <h2>Tus archivos no salen de tu Mac.</h2>
        <p>Sin cuentas, sin subidas, sin telemetría. iRar funciona en el sandbox de macOS y solo accede a lo que tú eliges. Las contraseñas viven en memoria y desaparecen al cerrar.</p>
      </div>
    </section>

    <!-- DOWNLOAD -->
    <section id="preguntas" class="section">
      <div class="reveal">
        <p class="kicker">Preguntas</p>
        <h2>Lo que más<br><span class="gradient-text">se pregunta.</span></h2>
      </div>
      <Faq items={getLegal('irar').faq} />
    </section>

    <DownloadCta app={app} icon="assets/icono-256.png" title="Lleva iRar" accent="a tu Mac."
                 sub="Gratis. Abre, crea y edita tus archivos comprimidos sin salir del Finder."
                 requirements={['macOS 26 o posterior', 'Apple Silicon e Intel', 'Firmado por Developer ID']}>
      <DownloadButton app={app} size="lg">Descargar iRar {app.version}</DownloadButton>
      <Button href="support.html" variant="ghost" size="lg">Soporte</Button>
    </DownloadCta>
  </main>

