---
// La Baraja: siete juegos con la baraja española (Brisca, Chinchón, Escoba, Tute, Mus, Pirámide y Solitario) para
// iPhone, iPad, teléfonos y tablets Android, Mac, Windows y Linux, contra la IA o en red local entre todos ellos.
// Descargas de escritorio: apps.json → desktop (sin enlace, «Próximamente»). Familia aurora con los colores de la Baraja Mochi; lo propio
// es la galería de mesas y el abanico de cartas (styles/pages/labaraja.css). Marcos de iPhone y iPad:
// styles/devices.css. Datos verificados en ~/Desarrollo/LaBaraja (docs/PLAN.md y CLAUDE.md).
import AppLayout from '../../layouts/AppLayout.astro';
import Footer from '../../components/layout/Footer.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import StoreButtons from '../../components/ui/StoreButtons.astro';
import Hero from '../../components/sections/Hero.astro';
import Marquee from '../../components/sections/Marquee.astro';
import Section from '../../components/sections/Section.astro';
import Bento from '../../components/sections/Bento.astro';
import BentoCard from '../../components/sections/BentoCard.astro';
import Steps from '../../components/sections/Steps.astro';
import Principles from '../../components/sections/Principles.astro';
import Faq from '../../components/sections/Faq.astro';
import DownloadCta from '../../components/sections/DownloadCta.astro';
import { getApp } from '../../lib/apps';
import '../../styles/devices.css';
import '../../styles/pages/labaraja.css';

const app = getApp('labaraja');
const IMG = '/labaraja/img/';

// Iconos de las plataformas.
const PHONE = '<rect x="3" y="3" width="8" height="16" rx="2"/><rect x="13" y="6" width="9" height="13" rx="2"/><path d="M6.5 16h1M17 16h1"/>';
const ANDROID = '<rect x="5" y="9" width="14" height="10" rx="2"/><path d="M8 9a4 4 0 0 1 8 0M9 6 8 4M15 6l1-2M10 13h.01M14 13h.01"/>';
const MAC = '<rect x="4" y="4" width="16" height="11" rx="1.5"/><path d="M2 19h20M10 15l-.5 4M14 15l.5 4"/>';
const WINDOWS = '<path d="M3 5.5 10.5 4.5v7H3zM12.5 4.2 21 3v8.5h-8.5zM3 13.5h7.5v7L3 19.5zM12.5 13.5H21V22l-8.5-1.2z"/>';
const LINUX = '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M12 15h5"/>';

// Iconos de los juegos (trazos, como los del resto del bento).
const COIN = '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/>';
const CUP = '<path d="M6 3h12c0 5-2.7 8-6 8s-6-3-6-8z"/><path d="M12 11v6M8 21h8M10 17h4"/>';
const SWORD = '<path d="M12 2l2 3v11h-4V5z"/><path d="M7 16h10M12 16v4"/><circle cx="12" cy="21" r="1"/>';
const CROWN = '<path d="M4 18 3 8l5 4 4-6 4 6 5-4-1 10z"/><path d="M4 21h16"/>';
const BUBBLE = '<path d="M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-7l-5 4v-4H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="M12 8v3M12 14h.01"/>';
const PYRAMID = '<path d="M12 3 22 20H2z"/><path d="M7 14h10M9.5 9.5h5"/>';
const desk = app.desktop ?? {};
const STACK = '<rect x="8" y="3" width="12" height="16" rx="2"/><path d="M5 6v13a2 2 0 0 0 2 2h9"/>';
---
<AppLayout slug="labaraja"
  nav={[['#juegos', 'Juegos'], ['#plataformas', 'Descargar'], ['#red-local', 'Red local'], ['#preguntas', 'Preguntas']]}
  toast="🃏 ¡Gracias! Abre La Baraja y reparte la primera mano.">

  <Hero icon={app.home!.logo} iconAlt="Ícono de La Baraja" pill={`La Baraja ${app.version} · móvil, tablet y computadora`}
        title="La baraja española," accent="siempre a la mano."
        meta={['7 juegos', 'iPhone · iPad · Android · Mac · Windows · Linux', 'Gratis y sin anuncios']}>
    <Fragment slot="lead">Brisca, Chinchón, Escoba, Tute, Mus, Pirámide y Solitario con una <strong>baraja ilustrada propia</strong>. En tu <strong>teléfono, tu tablet o tu computadora</strong>: juega contra una IA con tres niveles o reúne a tus amigos en <strong>tu misma red Wi-Fi</strong>, cada uno con el dispositivo que tenga. Sin cuentas, sin internet y sin anuncios.</Fragment>
    <Fragment slot="cta">
      <StoreButtons slug="labaraja" bare />
      <Button href="#plataformas" variant="ghost">Mac, Windows y Linux <Icon name="arrow-down" /></Button>
    </Fragment>
    <div class="dv-phones reveal">
      <figure class="dv-phone dv-side"><img src={`${IMG}iphone-inicio.webp`} alt="Inicio de La Baraja: lista de juegos con Brisca, Chinchón, Escoba, Tute, Mus y Pirámide" width="603" height="1311" loading="lazy"></figure>
      <figure class="dv-phone dv-main"><img src={`${IMG}iphone-chinchon.webp`} alt="Mesa de Chinchón: tus siete cartas abajo, el mazo y el descarte en el centro y Drácula, la IA, arriba" width="603" height="1311"></figure>
      <figure class="dv-phone dv-side"><img src={`${IMG}iphone-escoba.webp`} alt="Mesa de Escoba con cartas en el centro que suman 15" width="603" height="1311" loading="lazy"></figure>
    </div>
  </Hero>

  <Marquee items={['Brisca', 'Chinchón', 'Escoba', 'Tute', 'Mus', 'Pirámide', 'Solitario', 'iPhone', 'iPad', 'Teléfonos Android', 'Tablets Android', 'Mac', 'Windows', 'Linux', 'Juego cruzado', 'Red local', 'IA en tres niveles', 'Sin anuncios']} />

  <main id="contenido">
    <Section id="juegos" flush eyebrow="siete juegos" title="Una baraja." accent="Siete maneras de jugarla."
             sub="Los clásicos de mesa y de sobremesa, con sus reglas de siempre. Cada mesa explica las suyas con el botón «?».">
      <Bento>
        <BentoCard span={3} title="Brisca" icon={COIN}>
          <Fragment slot="text">De 2 o de 4 por parejas. Gana quien pasa de 60 de los 120 puntos, con cambio del triunfo como lo juegas tú.</Fragment>
        </BentoCard>
        <BentoCard span={3} title="Chinchón" icon={CUP}>
          <Fragment slot="text">De 2 a 6 jugadores, con comodines. Liga escaleras y tríos, cierra con pocas sueltas o busca el chinchón que gana la partida.</Fragment>
        </BentoCard>
        <BentoCard title="Escoba" icon={SWORD}>
          <Fragment slot="text">De 2 a 4. Llévate las cartas que suman 15 y barre la mesa para cantar escoba.</Fragment>
        </BentoCard>
        <BentoCard title="Tute" icon={CROWN}>
          <Fragment slot="text">De 2 con monte o de 4 por parejas. Cantes de 20 y 40, diez de últimas y al mejor de tres juegos.</Fragment>
        </BentoCard>
        <BentoCard title="Mus" icon={BUBBLE}>
          <Fragment slot="text">Cuatro jugadores por parejas: mus, descartes, Grande, Chica, Pares y Juego, envites y órdago.</Fragment>
        </BentoCard>
        <BentoCard span={3} title="Pirámide" icon={PYRAMID}>
          <Fragment slot="text">Para ti solo: quita parejas que sumen 13 hasta deshacer la pirámide.</Fragment>
        </BentoCard>
        <BentoCard span={3} title="Solitario" icon={STACK}>
          <Fragment slot="text">El de siempre, con siete columnas y cuatro montones de As a Rey. Toca una carta y se va sola a su sitio.</Fragment>
        </BentoCard>
      </Bento>
    </Section>

    <Section id="plataformas" center eyebrow="en todas tus pantallas" title="Tu teléfono, tu tablet," accent="tu computadora."
             sub="La misma Baraja en seis plataformas, y todas juegan juntas: un iPhone, una tablet Android y una laptop con Windows pueden compartir mesa en la misma Wi-Fi.">
      <Bento>
        <BentoCard span={3} title="iPhone, iPad y Mac" icon={PHONE}>
          <Fragment slot="text">Desde el App Store, con logros y marcadores de Game Center: en iPhone y iPad con iOS y iPadOS 27 o posterior, y en Mac con chip de Apple.</Fragment>
          <StoreButtons slug="labaraja" bare only="apple" />
        </BentoCard>
        <BentoCard span={3} title="Teléfonos y tablets Android" icon={ANDROID}>
          <Fragment slot="text">Desde Google Play, en el teléfono y en la tablet, con logros de Google Play Games. Android 16 o posterior.</Fragment>
          <StoreButtons slug="labaraja" bare only="google" />
        </BentoCard>
        <BentoCard title="Mac" icon={MAC}>
          <Fragment slot="text">Descárgala directo de esta página para macOS 27, sin pasar por la tienda.</Fragment>
          {desk.mac
            ? <Button href={desk.mac} download size="sm">Descargar para Mac</Button>
            : <Button disabled size="sm">Próximamente para Mac</Button>}
        </BentoCard>
        <BentoCard title="Windows" icon={WINDOWS}>
          <Fragment slot="text">Instalador para Windows 11 de 64 bits.</Fragment>
          {desk.windows
            ? <Button href={desk.windows} download size="sm">Descargar para Windows</Button>
            : <Button disabled size="sm">Próximamente para Windows</Button>}
        </BentoCard>
        <BentoCard title="Linux" icon={LINUX}>
          <Fragment slot="text">Paquetes DEB y RPM para Ubuntu 24.04 o posterior y Fedora, de 64 bits.</Fragment>
          {desk.deb || desk.rpm
            ? <div class="lb-dl">{desk.deb && <Button href={desk.deb} download size="sm">DEB</Button>}{desk.rpm && <Button href={desk.rpm} download size="sm" variant="ghost">RPM</Button>}</div>
            : <Button disabled size="sm">Próximamente para Linux</Button>}
        </BentoCard>
      </Bento>
      <p class="lb-note reveal">Las versiones que se descargan de esta página tienen todo el juego y la red local; solo les faltan los logros y las donaciones, que van con el App Store y Google Play.</p>
    </Section>

    <Section id="mesas" center eyebrow="cada juego, su mesa" title="Cartas que da gusto" accent="tener en la mano."
             sub="La Baraja Mochi: figuras con carita, palos de colores y animaciones al repartir, jugar y ganar la baza. En vertical o en horizontal.">
      <div class="lb-gallery">
        <figure class="dv-phone reveal"><img src={`${IMG}iphone-brisca.webp`} alt="Mesa de Brisca contra Drácula, con el triunfo de espadas" width="603" height="1311" loading="lazy"><figcaption>Brisca</figcaption></figure>
        <figure class="dv-phone reveal"><img src={`${IMG}iphone-tute.webp`} alt="Mesa de Tute: tus diez cartas abajo y el monte con el triunfo" width="603" height="1311" loading="lazy"><figcaption>Tute</figcaption></figure>
        <figure class="dv-phone reveal"><img src={`${IMG}iphone-mus.webp`} alt="Mesa de Mus con Lobo, Momia y Drácula y los lances Grande, Chica, Pares y Juego" width="603" height="1311" loading="lazy"><figcaption>Mus</figcaption></figure>
        <figure class="dv-phone reveal"><img src={`${IMG}iphone-piramide.webp`} alt="Pirámide de cartas boca arriba con el mazo abajo" width="603" height="1311" loading="lazy"><figcaption>Pirámide</figcaption></figure>
        <figure class="dv-phone reveal"><img src={`${IMG}iphone-solitario.webp`} alt="Solitario con siete columnas y los montones de As a Rey" width="603" height="1311" loading="lazy"><figcaption>Solitario</figcaption></figure>
      </div>
    </Section>

    <Section flush eyebrow="contra la ia" title="Rivales con personalidad." accent="Y con paciencia."
             sub="Drácula, Momia, Lobo y compañía completan la mesa cuando faltan jugadores. Deciden solo con lo que ven: nunca miran tus cartas.">
      <Principles items={[
        ['Fácil', 'Para aprender: juega con ganas, pero se despista y no siempre cierra a la primera.'],
        ['Normal', 'Juega como alguien con experiencia: guarda las buenas para el final y no te regala nada.'],
        ['Difícil', 'Mira más allá de la jugada de ahora y aprovecha cada error. Ganarle se nota.'],
        ['Pista', '¿No sabes qué jugar? Toca la bombilla y la IA te marca la carta que ella elegiría.'],
      ]} />
    </Section>

    <Section id="red-local" center eyebrow="con tus amigos" title="Una mesa, varios teléfonos." accent="Cero internet."
             sub="Quien crea la mesa hace de anfitrión; los demás se unen desde la lista o con el código de sala. Da igual el dispositivo: iPhone, iPad, teléfonos y tablets Android, Mac, Windows y Linux juegan en la misma mesa, y la IA ocupa los asientos libres.">
      <div class="dv-duo">
        <figure class="dv-phone dv-main reveal"><img src={`${IMG}iphone-sala.webp`} alt="Sala de una mesa de Brisca en el iPhone con el código de sala y el iPad sentado como otro jugador" width="603" height="1311" loading="lazy"></figure>
        <figure class="dv-tablet reveal"><img src={`${IMG}ipad-sala.webp`} alt="La misma sala de Brisca vista desde el iPad" width="1400" height="919" loading="lazy"></figure>
      </div>
    </Section>

    <Section flush center eyebrow="listo en un minuto" title="Crea. Únete." accent="Reparte.">
      <Steps items={[
        ['Crea la mesa', 'En <b>Red local</b>, elige el juego y toca <b>Crear mesa</b>. Tu dispositivo, sea cual sea, es el anfitrión.'],
        ['Únete', 'Los demás la ven en su lista, en la misma Wi-Fi. Si tu red lo bloquea, escriben el <b>código de sala</b>.'],
        ['Reparte', 'Los asientos libres los ocupa la IA. Si alguien pierde la conexión, la IA juega por él hasta que vuelva.'],
      ]} />
    </Section>

    <Section id="tablet" center eyebrow="tablets y computadoras" title="Toda la mesa," accent="a lo grande."
             sub="En iPad, en tablets Android y en la computadora, la mesa se reacomoda a la pantalla para que veas todo: tu mano, las bazas, el mazo y a tus rivales. En el teléfono, en vertical o en horizontal.">
      <figure class="dv-tablet dv-wide reveal"><img src={`${IMG}ipad-chinchon.webp`} alt="Mesa de Chinchón en una tablet: tus cartas ordenadas abajo, con las ligadas marcadas" width="1400" height="919" loading="lazy"></figure>
    </Section>

    <Section flush eyebrow="detalles" title="Pequeñas cosas" accent="que hacen la partida.">
      <Bento>
        <BentoCard span={4} title="Logros y marcadores" icon='<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4"/>'>
          <Fragment slot="text">49 logros y 8 marcadores en Game Center y Google Play Games: juega, gana y hasta pierde para conseguirlos. Son opcionales; la app funciona igual sin iniciar sesión.</Fragment>
        </BentoCard>
        <BentoCard title="Música 8 bits" icon='<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>'>
          <Fragment slot="text">Melodías de consola para el menú y la mesa, y efectos al repartir y ganar la baza. Se apagan con un toque.</Fragment>
        </BentoCard>
        <BentoCard title="Vibración" icon='<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M3 8v8M21 8v8"/>'>
          <Fragment slot="text">Un toque cuando es tu turno y otro al acabar la partida.</Fragment>
        </BentoCard>
        <BentoCard title="Reglas en la mesa" icon='<path d="M4 5a2 2 0 0 1 2-2h5v17H6a2 2 0 0 0-2 2zM20 5a2 2 0 0 0-2-2h-5v17h5a2 2 0 0 1 2 2z"/>'>
          <Fragment slot="text">Cada mesa explica su objetivo, lo que vale cada carta y las opciones que elegiste.</Fragment>
        </BentoCard>
        <BentoCard title="Tus variantes" icon='<path d="M4 7h16M4 12h16M4 17h16"/><circle cx="9" cy="7" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="8" cy="17" r="2"/>'>
          <Fragment slot="text">Cambio del triunfo, baraja de 40 o 48, límite para cerrar, tantos del Mus… cada mesa se ajusta a como juegas en casa.</Fragment>
        </BentoCard>
      </Bento>
    </Section>

    <Section flush eyebrow="privacidad" title="Tus partidas" accent="son solo tuyas.">
      <Principles items={[
        ['Sin cuentas ni servidores', 'No hay registro ni inicio de sesión. Tu nombre y tus partidas se guardan en tu dispositivo.'],
        ['Directo en tu Wi-Fi', 'Las mesas en red van de un dispositivo a otro dentro de tu red local, sea un teléfono, una tablet o una computadora. Nada pasa por internet.'],
        ['Sin anuncios ni rastreo', 'Ni publicidad, ni analíticas, ni funciones bloqueadas. Todos los juegos, completos y gratis.'],
        ['Donaciones opcionales', 'Si te gusta, puedes invitarme un café desde la app. No desbloquea nada.'],
      ]} />
    </Section>

    <Section id="preguntas" flush center eyebrow="preguntas" title="Antes de" accent="repartir.">
      <Faq items={[
        ['¿Cuánto cuesta?', 'Nada. La Baraja es gratis, sin anuncios y con todos los juegos completos. Las donaciones son opcionales y no desbloquean nada.'],
        ['¿Necesito internet?', 'No. Contra la IA se juega sin conexión. Para jugar con otras personas solo hace falta estar en la misma red Wi-Fi.'],
        ['¿Pueden jugar juntos un iPhone, un Android y una computadora?', 'Sí. iPhone, iPad, teléfonos y tablets Android, Mac, Windows y Linux se sientan en la misma mesa en red. Si tu red bloquea la búsqueda, usa el código de sala.'],
        ['¿Cuántos jugadores hacen falta?', 'Uno basta: la IA completa la mesa. Brisca y Tute son de 2 o de 4 por parejas, Escoba de 2 a 4, Chinchón de 2 a 6 y Mus de 4 por parejas. Pirámide y Solitario son para ti solo.'],
        ['¿Qué pasa si alguien se desconecta?', 'Una IA ocupa su asiento al momento y se lo devuelve en cuanto vuelve a la mesa, con sus cartas.'],
        ['¿Por qué me pide acceso a la red local?', 'Es lo que permite encontrar y crear mesas en tu Wi-Fi. Solo se usa para jugar en red.'],
        ['¿Hay versión para computadora?', 'Sí: para Mac, Windows y Linux, que se descargan desde esta página. En un Mac con chip de Apple también puedes instalarla desde el App Store, con logros de Game Center.'],
        ['¿Funciona en tablets Android?', 'Sí. La Baraja se adapta a teléfonos y tablets Android, en vertical o en horizontal, igual que en iPhone y iPad.'],
        ['¿Las versiones de computadora tienen logros?', 'Las que se descargan de esta página no: los logros son los de Game Center y Google Play Games. El juego, las reglas y la red local son los mismos.'],
      ]} />
    </Section>

    <DownloadCta app={app} eyebrow="saca la baraja" title="¿Echamos" accent="una partida?"
                 sub="En tu teléfono, tu tablet o tu computadora. Gratis, sin cuentas y sin anuncios."
                 requirements={['iOS y iPadOS 27', 'Android 16 · teléfono y tablet', 'macOS 27', 'Windows 11 x64', 'Ubuntu 24.04+ · Fedora', 'Misma Wi-Fi para jugar en red']}>
      <div slot="art" class="lb-fan" aria-hidden="true">
        <img src={`${IMG}carta-as-espadas.webp`} alt="" width="300" height="468" loading="lazy">
        <img src={`${IMG}carta-as-oros.webp`} alt="" width="300" height="468" loading="lazy">
        <img src={`${IMG}carta-as-copas.webp`} alt="" width="300" height="468" loading="lazy">
      </div>
      <StoreButtons slug="labaraja" bare />
      <Button href="#plataformas" variant="ghost">Mac, Windows y Linux</Button>
    </DownloadCta>
  </main>

  <Footer slot="footer" app={app} giant tagline="Brisca, Chinchón, Escoba, Tute, Mus, Pirámide y Solitario con la baraja española, en iPhone, iPad, Android, Mac, Windows y Linux. Gratis y sin anuncios." />
</AppLayout>
