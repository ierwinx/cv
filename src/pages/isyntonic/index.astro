---
// iSyntonic: control remoto para Google TV, Android TV y Fire TV en iPhone y iPad. Familia aurora; lo único
// propio son los marcos de iPhone y iPad con capturas reales (styles/pages/isyntonic.css).
import AppLayout from '../../layouts/AppLayout.astro';
import Footer from '../../components/layout/Footer.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Hero from '../../components/sections/Hero.astro';
import Marquee from '../../components/sections/Marquee.astro';
import Section from '../../components/sections/Section.astro';
import Bento from '../../components/sections/Bento.astro';
import BentoCard from '../../components/sections/BentoCard.astro';
import Steps from '../../components/sections/Steps.astro';
import Principles from '../../components/sections/Principles.astro';
import Faq from '../../components/sections/Faq.astro';
import DownloadCta from '../../components/sections/DownloadCta.astro';
import { getApp } from '../../lib/apps';
import '../../styles/pages/isyntonic.css';

const app = getApp('isyntonic');
const IMG = '/isyntonic/img/';
const APPLE = '<path fill="currentColor" d="M16.37 12.6c.02 2.5 2.2 3.33 2.22 3.34-.02.06-.35 1.18-1.14 2.35-.69 1-1.41 2-2.53 2.03-1.11.02-1.47-.66-2.74-.66s-1.66.64-2.71.68c-1.09.04-1.92-1.09-2.61-2.09-1.42-2.05-2.5-5.78-1.05-8.3.72-1.25 2.01-2.05 3.41-2.07 1.07-.02 2.07.72 2.73.72.65 0 1.87-.89 3.16-.76.54.02 2.05.22 3.02 1.64-.08.05-1.8 1.05-1.78 3.13zM14.3 4.98c.58-.7.97-1.67.86-2.64-.83.03-1.84.55-2.44 1.25-.53.62-1 1.61-.88 2.56.93.07 1.88-.47 2.46-1.17z"/>';
---
<AppLayout slug="isyntonic"
  nav={[['#funciones', 'Funciones'], ['#minicontrol', 'Minicontrol'], ['#ipad', 'iPad'], ['#preguntas', 'Preguntas']]}
  toast="📺 ¡Gracias! Abre iSyntonic y agrega tu primera pantalla.">

  <Hero icon={app.home!.logo} iconAlt="Ícono de iSyntonic" pill={`iSyntonic ${app.version} · para iPhone y iPad`}
        title="Tu TV," accent="en la palma de tu mano."
        meta={['Google TV · Android TV · Fire TV', 'Gratis y sin anuncios', 'Sin cuentas']}>
    <Fragment slot="lead">El control remoto que siempre encuentras: <strong>tu iPhone</strong>. Desliza para navegar, <strong>escribe con tu teclado</strong> y pausa desde la <strong>pantalla bloqueada</strong>. Todo por tu Wi-Fi, sin cuentas y sin mandar tus datos a ningún servidor.</Fragment>
    <Fragment slot="cta">
      {app.install
        ? <Button href={app.install} ring external><svg viewBox="0 0 24 24" aria-hidden="true" set:html={APPLE} /><span>Descargar en el App Store</span></Button>
        : <Button disabled><svg viewBox="0 0 24 24" aria-hidden="true" set:html={APPLE} /><span>Próximamente en el App Store</span></Button>}
      <Button href="#funciones" variant="ghost">Ver cómo funciona <Icon name="arrow-down" /></Button>
    </Fragment>
    <div class="is-phones reveal">
      <figure class="is-phone is-side"><img src={`${IMG}iphone-pantallas.webp`} alt="Agregar pantalla: iSyntonic encuentra un Fire TV y una TV Sony en la red Wi-Fi" width="603" height="1311" loading="lazy"></figure>
      <figure class="is-phone is-main"><img src={`${IMG}iphone-control.webp`} alt="Control de iSyntonic: superficie táctil con el rastro del dedo y arco con Inicio, Atrás y Reproducir" width="603" height="1311"></figure>
      <figure class="is-phone is-side"><img src={`${IMG}iphone-teclado.webp`} alt="Escribir en la TV con el teclado del iPhone" width="603" height="1311" loading="lazy"></figure>
    </div>
  </Hero>

  <Marquee items={['Google TV', 'Android TV', 'Fire TV', 'Superficie táctil', 'Teclado del iPhone', 'Minicontrol', 'Centro de control', 'Botón de Acción', 'Siri', 'Modo zurdo', 'iPad', 'VoiceOver', 'Sin cuentas', 'Sin anuncios']} />

  <main id="contenido">
    <Section id="funciones" flush eyebrow="funciones" title="Todo lo que hace tu control." accent="Y lo que no puede."
             sub="Navega, escribe, sube el volumen y cambia de pantalla desde el teléfono que siempre traes en la mano.">
      <Bento>
        <BentoCard span={4} title="Una superficie táctil, no botones diminutos" icon='<rect x="5" y="2" width="14" height="20" rx="3"/><circle cx="12" cy="10" r="2"/><path d="M12 14v4"/>'>
          <Fragment slot="text">Desliza en cualquier parte de la pantalla para moverte por los menús y toca para seleccionar. Cada paso vibra, así sientes lo que haces sin mirar el teléfono. Inicio, Atrás y Reproducir quedan en un arco al alcance del pulgar.</Fragment>
        </BentoCard>
        <BentoCard title="Escribe con tu teclado" icon='<rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"/>'>
          <Fragment slot="text">Busca películas, series o contraseñas con el teclado del iPhone y el texto aparece en tu TV.</Fragment>
        </BentoCard>
        <BentoCard title="Varias pantallas" icon='<rect x="2" y="4" width="13" height="9" rx="1.5"/><rect x="9" y="11" width="13" height="9" rx="1.5"/>'>
          <Fragment slot="text">La TV de la sala, la de la recámara y el Fire TV del estudio. Cambia entre ellas con un toque y marca tu favorita con una estrella.</Fragment>
        </BentoCard>
        <BentoCard title="Volumen y reproducción" icon='<path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/>'>
          <Fragment slot="text">Sube, baja o silencia el volumen y reproduce o pausa. Solo ves los botones que tu pantalla acepta.</Fragment>
        </BentoCard>
        <BentoCard title="Diestro o zurdo" icon='<path d="M8 13V5a2 2 0 0 1 4 0v6"/><path d="M12 11V4a2 2 0 0 1 4 0v8"/><path d="M16 9a2 2 0 0 1 4 0v5a7 7 0 0 1-7 7h-1a7 7 0 0 1-6-3.4L4 15a2 2 0 0 1 3.4-2L8 14"/>'>
          <Fragment slot="text">El arco de botones se acomoda a la mano con la que usas el control.</Fragment>
        </BentoCard>
        <BentoCard span={3} title="Se reconecta sola" icon='<path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>'>
          <Fragment slot="text">Empareja tu TV una vez. Si cambia de dirección en tu red, iSyntonic la vuelve a encontrar sin pedirte el código otra vez.</Fragment>
        </BentoCard>
        <BentoCard span={3} title="Pruébala sin TV" icon='<path d="M5 3l14 9-14 9z"/>'>
          <Fragment slot="text">El modo demo simula una TV para que conozcas el control antes de tener una a la mano.</Fragment>
        </BentoCard>
      </Bento>
    </Section>

    <Section id="minicontrol" center eyebrow="sin abrir la app" title="Siempre" accent="a la mano."
             sub="El minicontrol se queda en tu pantalla bloqueada mientras ves la TV. También tienes botones para el Centro de control y el botón de Acción, y atajos de Siri como «Pausar con iSyntonic».">
      <div class="is-duo">
        <figure class="is-phone is-main reveal"><img src={`${IMG}iphone-minicontrol.webp`} alt="Minicontrol de iSyntonic en la pantalla bloqueada del iPhone, con flechas, OK, Atrás y volumen" width="603" height="1311" loading="lazy"></figure>
        <figure class="is-tablet reveal"><img src={`${IMG}ipad-minicontrol.webp`} alt="Minicontrol de iSyntonic en la pantalla bloqueada del iPad" width="1400" height="919" loading="lazy"></figure>
      </div>
    </Section>

    <Section flush center eyebrow="listo en un minuto" title="Busca. Empareja." accent="Controla.">
      <Steps items={[
        ['Busca', 'Abre iSyntonic y toca <b>Agregar pantalla</b>. La app encuentra sola las TVs de tu red Wi-Fi.'],
        ['Empareja', 'Elige tu TV y escribe el código que aparece en ella. Solo se hace una vez.'],
        ['Controla', 'Desliza, toca, escribe y sube el volumen. La próxima vez se conecta en cuanto abres la app.'],
      ]} />
    </Section>

    <Section id="ipad" center eyebrow="hecho para ipad" title="Tus pantallas a un lado." accent="El control al otro."
             sub="En iPad, tus TVs quedan en un panel y el control se usa cómodo con las dos manos. Oculta el panel con un botón cuando solo quieras el control.">
      <figure class="is-tablet is-wide reveal"><img src={`${IMG}ipad-pantallas.webp`} alt="iSyntonic en iPad: lista de pantallas a la izquierda y control a la derecha" width="1400" height="919" loading="lazy"></figure>
    </Section>

    <Section flush eyebrow="privacidad" title="Habla con tu TV." accent="Con nadie más.">
      <Principles items={[
        ['Directo en tu red', 'iSyntonic se comunica con tu TV dentro de tu Wi-Fi. Tus comandos no pasan por ningún servidor.'],
        ['Sin cuentas ni rastreo', 'No hay registro, inicio de sesión, analíticas ni anuncios. La app no recopila ningún dato.'],
        ['Tus llaves, en tu teléfono', 'La credencial de cada TV se guarda en el llavero del dispositivo. Si borras una pantalla, su llave se borra con ella.'],
        ['Accesible', 'Compatible con VoiceOver, en español e inglés, y con un modo para zurdos.'],
      ]} />
    </Section>

    <Section id="preguntas" flush center eyebrow="preguntas" title="Antes de" accent="tomar el control.">
      <Faq items={[
        ['¿Con qué TVs funciona?', 'Con Google TV, Android TV (como las TVs Sony, TCL o Hisense con Google TV) y Fire TV de Amazon. Tu iPhone o iPad y la TV deben estar en la misma red Wi-Fi.'],
        ['¿Por qué me pide acceso a la red local?', 'Es la forma en que iOS permite a una app buscar tu TV en tu Wi-Fi y enviarle los comandos. Nada sale de tu red.'],
        ['¿Tengo que emparejar cada vez?', 'No. Escribes el código una sola vez por TV. Si la TV cambia de dirección en tu red, iSyntonic la vuelve a encontrar.'],
        ['¿Cuánto cuesta?', 'Nada. iSyntonic es gratis, sin anuncios y sin funciones bloqueadas. Si te gusta, puedes invitarme un café desde Ajustes; es opcional y no desbloquea nada.'],
        ['¿Funciona con Apple TV o Roku?', 'Todavía no. Por ahora iSyntonic controla Google TV, Android TV y Fire TV.'],
      ]} />
    </Section>

    <DownloadCta app={app} eyebrow="deja el control en el sillón" title="Tu TV," accent="en tu iPhone."
                 sub="Descarga iSyntonic, agrega tu pantalla y listo. Gratis, sin cuentas y sin anuncios."
                 requirements={['iOS 26 o posterior', 'iPhone y iPad', 'Google TV · Android TV · Fire TV', 'Misma red Wi-Fi']}>
      {app.install
        ? <Button href={app.install} ring external><svg viewBox="0 0 24 24" aria-hidden="true" set:html={APPLE} /><span>Descargar en el App Store</span></Button>
        : <Button disabled><svg viewBox="0 0 24 24" aria-hidden="true" set:html={APPLE} /><span>Próximamente en el App Store</span></Button>}
    </DownloadCta>
  </main>

  <Footer slot="footer" app={app} giant tagline="Control remoto para Google TV, Android TV y Fire TV en tu iPhone y iPad. Gratis, sin cuentas y sin anuncios." />
</AppLayout>
