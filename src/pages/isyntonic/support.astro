---
// Soporte de iSyntonic (app de iPhone y iPad): primeros pasos, preguntas frecuentes y formulario de contacto.
import LegalShell from '../../components/legal/LegalShell.astro';
import Faq from '../../components/sections/Faq.astro';
import ContactForm from '../../components/ui/ContactForm.astro';
import { getApp } from '../../lib/apps';

const app = getApp('isyntonic');
const faq: [string, string][] = [
  ['No encuentra mi TV', '<p>Revisa que la TV esté encendida y que tu iPhone o iPad esté en la <b>misma red Wi-Fi</b>. Si la primera vez le negaste el permiso de red local, actívalo en <b>Ajustes → Privacidad y seguridad → Red local → iSyntonic</b>. Las redes de invitados o con aislamiento de clientes pueden bloquear la búsqueda.</p>'],
  ['¿Dónde veo el código para emparejar?', '<p>Al elegir tu TV en <b>Agregar pantalla</b>, la TV muestra un código. En Google TV y Android TV son 6 caracteres; en Fire TV, 4. Escríbelo en la app y toca <b>Emparejar</b>.</p>'],
  ['Dice «El código no coincide»', '<p>Vuelve a revisar el código en la TV: en Google TV y Android TV usa números y letras de la A a la F, así que fíjate en el 0 y la D, o el 8 y la B. Si el código desapareció de la TV, cancela y vuelve a elegirla para recibir uno nuevo.</p>'],
  ['Dice «Vuelve a emparejar esta pantalla»', '<p>La TV olvidó la conexión, por ejemplo tras restablecerla o actualizarla. Toca la pantalla y escribe el código nuevo que aparece en la TV.</p>'],
  ['¿Cómo uso el minicontrol?', '<p>Abre el Centro de control y agrega el botón <b>Minicontrol</b> de iSyntonic, o pídeselo a Siri: «Mostrar minicontrol de iSyntonic». Aparece en la pantalla bloqueada mientras ves la TV; ciérralo con la ✕.</p>'],
  ['¿Cómo escribo en la TV?', '<p>Toca el botón del teclado arriba del control, escribe y toca <b>Enviar</b>. El texto aparece en el campo de búsqueda que tengas abierto en la TV.</p>'],
  ['¿Cómo cambio de TV o borro una?', '<p>Toca el nombre de la TV arriba del control para ver <b>Mis pantallas</b>. Toca otra para cambiar, la estrella para que se abra siempre esa, o desliza a la izquierda para borrarla.</p>'],
  ['¿Funciona con Apple TV o Roku?', '<p>Todavía no. Por ahora iSyntonic controla Google TV, Android TV y Fire TV.</p>'],
  ['¿Cuánto cuesta?', '<p>Nada. Es gratis, sin anuncios y sin funciones bloqueadas. Las propinas de Ajustes son opcionales y no desbloquean nada.</p>'],
];
---
<LegalShell app={app} title="Soporte — iSyntonic"
            description="Soporte de iSyntonic: cómo agregar y emparejar tu Google TV, Android TV o Fire TV, minicontrol, teclado, preguntas frecuentes y contacto."
            eyebrow="Ayuda" heading="¿Cómo te" accent="ayudamos?">
  <p class="lg-lead reveal">Respuestas rápidas a lo más común. Si no está aquí, escríbeme y te respondo lo antes posible.</p>

  <div class="lg-cards">
    <div class="lg-card reveal"><b>Requisitos</b><p>iPhone o iPad con iOS 26 o posterior, y una TV con Google TV, Android TV o Fire TV en la misma red Wi-Fi.</p></div>
    <div class="lg-card reveal"><b>Versión actual</b><p>{app.name} {app.version} · gratis</p></div>
  </div>

  <h2>Primeros pasos</h2>
  <ol class="lg-steps">
    <li>Enciende tu TV y conecta tu iPhone o iPad a la misma red Wi-Fi.</li>
    <li>Abre iSyntonic, toca <b>Agregar pantalla</b> y permite el acceso a la red local.</li>
    <li>Elige tu TV y escribe el código que aparece en ella.</li>
  </ol>
  <p>¿No tienes la TV a la mano? Toca <b>Probar sin TV</b> para usar una TV de demostración.</p>

  <h2>Preguntas frecuentes</h2>
  <Faq items={faq} />

  <div class="lg-contact reveal" id="contacto">
    <h2>Escríbeme</h2>
    <p>Para reportar un problema, incluye el modelo de tu iPhone o iPad, la versión de iOS y la marca y modelo de tu TV.</p>
    <ContactForm origen="isyntonic" placeholder="Cuéntame qué pasó con iSyntonic: modelo de iPhone o iPad, versión de iOS y marca y modelo de tu TV." />
  </div>
</LegalShell>
