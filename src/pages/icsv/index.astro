---
// iCSV: diseño propio (Inter Tight, teal y naranja). Estilos en styles/pages/icsv.css, comportamiento en scripts/pages/icsv.ts.
import AppPage from '../../layouts/AppPage.astro';
import { downloadUrl, getApp } from '../../lib/apps';
import '../../styles/pages/icsv.css';

const app = getApp('icsv');
const dl = downloadUrl(app);
const sha = app.release!.sha256!;
---
<AppPage slug="icsv">
<div class="ambient"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div></div>
<div class="gridbg"></div>
<canvas id="particles"></canvas>
<div class="cursor-glow" id="glow"></div>
<div class="noise"></div>
<div class="progress" id="progress"></div>
<canvas id="confetti"></canvas>
<div class="toast" id="toast"></div>

<nav class="top" id="nav">
  <a href="#" class="brand"><img src="assets/icon.png" alt=""><span>iCSV</span></a>
  <div class="navlinks">
    <a href="#por-que">Por qué</a>
    <a href="#fidelidad">Fidelidad</a>
    <a href="#rendimiento">Rendimiento</a>
    <a href="#faq">FAQ</a>
  </div>
  <a href={dl} download class="btn btn-primary btn-sm magnetic js-download">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 5-5m-5 5-5-5M4 21h16"/></svg>
    Descargar
  </a>
</nav>

<!-- ================= HERO ================= -->
<header class="hero">
  <div class="wrap">
    <img class="hero-icon" src="assets/icon.png" alt="Icono de iCSV">
    <div class="badge"><b>v1.0</b><span class="dot"></span> Firmada y notarizada por Apple</div>
    <h1 id="headline"><span class="word">Tus</span> <span class="word">CSV,</span> <span class="word grad">al</span> <span class="word grad">instante.</span></h1>
    <p class="lead">iCSV es el editor de archivos delimitados para Mac que abre un gigabyte sin pestañear y guarda tus datos <strong>exactamente</strong> como estaban. Sin asistentes de importación. Sin ceros perdidos. Sin esperar.</p>
    <div class="cta-row">
      <a href={dl} download class="btn btn-primary magnetic js-download">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.28-1.6 2.78-.41 6.9 1.15 9.15.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.4-.92-2.38-3.68ZM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.67-1.09 1.76-.96 2.8 1.02.08 2.05-.51 2.68-1.28Z"/></svg>
        Descargar para Mac
      </a>
      <a href="#por-que" class="btn btn-ghost magnetic">Descubre por qué →</a>
    </div>
    <div class="meta"><span>Gratis</span><span>2,5 MB</span><span>Apple Silicon + Intel</span><span>macOS 26 o posterior</span></div>

    <div class="stage">
      <div class="stage-rel">
        <div class="floating-chip c1">⚡ 1,2 GB/s indexando</div>
        <div class="floating-chip c2">✓ 0 bytes alterados</div>
        <div class="window" id="win">
          <div class="titlebar">
            <div class="lights"><i></i><i></i><i></i></div>
            <div class="name">ventas_2026.csv <small>— Editado</small></div>
            <div class="tools"><span>⌘F Buscar</span><span>Formato ▾</span></div>
          </div>
          <div class="grid-wrap">
            <table class="grid" id="grid">
              <thead><tr><th class="gut"></th><th>id</th><th>cliente</th><th>ciudad</th><th class="hide-sm">código_postal</th><th>importe</th><th class="hide-sm">fecha</th></tr></thead>
              <tbody></tbody>
            </table>
            <div class="grid-fade"></div>
          </div>
          <div class="statusbar">
            <span>Codificación <b>UTF-8 + BOM</b></span>
            <span>Separador <b>;</b></span>
            <span>Fin de línea <b>CRLF</b></span>
            <span class="right"><b id="rowcount" data-count="1048576">0</b> filas · 7 columnas</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- ================= MARQUEE ================= -->
<div class="marquee" aria-hidden="true">
  <div class="track" id="marquee"></div>
</div>

<!-- ================= STATS ================= -->
<section style="padding-bottom: 40px;">
  <div class="wrap">
    <div class="stats reveal">
      <div class="stat"><div class="n"><span class="count" data-to="1200">0</span><small>MB/s</small></div><p>de lectura en Apple Silicon. Un archivo de 100 MB se indexa en menos de una décima de segundo.</p></div>
      <div class="stat"><div class="n"><span class="count" data-to="4">0</span><small>GB/s</small></div><p>de escritura por la ruta rápida de bytes crudos al guardar.</p></div>
      <div class="stat"><div class="n"><span class="count" data-to="0">0</span><small>bytes</small></div><p>cambiados en lo que no tocas. Abrir y guardar produce un archivo idéntico.</p></div>
      <div class="stat"><div class="n"><span class="count" data-to="0">0</span><small>dependencias</small></div><p>de terceros. 100 % Swift 6 y SwiftUI nativo, nada de Electron.</p></div>
    </div>
  </div>
</section>

<!-- ================= WHY / BENTO ================= -->
<section id="por-que">
  <div class="wrap">
    <span class="eyebrow reveal">Por qué iCSV</span>
    <h2 class="title reveal d1">Hecha para gente que <span class="grad">vive en datos.</span></h2>
    <p class="lead reveal d2">Excel convierte tus datos. Los editores de texto no entienden columnas. Las apps web suben tus archivos a la nube. iCSV hace una sola cosa y la hace sin concesiones.</p>

    <div class="bento" id="bento">
      <article class="card span-4 reveal">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
        <h3>Rápida por diseño, no por casualidad</h3>
        <p>El parser lee bytes, no texto: una sola pasada y cero memoria por celda. El grid solo dibuja lo que ves, así que 100 filas o 10 millones se sienten igual.</p>
        <div class="speedo" id="speedo">
          <div class="bar-row"><span>Lectura</span><div class="bar"><i data-w="100"></i></div><b>1 200 MB/s</b></div>
          <div class="bar-row"><span>Objetivo</span><div class="bar"><i class="dim" data-w="33"></i></div><b>400 MB/s</b></div>
          <div class="bar-row"><span>Escritura</span><div class="bar"><i class="o" data-w="100"></i></div><b>4 GB/s</b></div>
        </div>
      </article>

      <article class="card span-2 reveal d1">
        <div class="ico o"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></div>
        <h3>Fiel byte a byte</h3>
        <p>Ceros a la izquierda, fechas, decimales, BOM, <code style="font-family:var(--mono);color:var(--orange-2)">sep=</code>, saltos de línea… lo que no editas se guarda idéntico. Siempre.</p>
      </article>

      <article class="card span-3 reveal">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></div>
        <h3>Detecta todo, sin preguntar</h3>
        <p>Codificación, separador, comillas, escape, fin de línea y encabezado. Si se equivoca, lo corriges en un clic.</p>
        <div class="term" id="term"></div>
      </article>

      <article class="card span-3 reveal d1">
        <div class="ico o"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="13" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 15h10"/></svg></div>
        <h3>Teclado primero, como una hoja de cálculo</h3>
        <p>Escribe para reemplazar, ↩ para editar, ⇥ para avanzar. Flechas, selección con ⇧ y atajos para todo.</p>
        <div class="keys" id="keys">
          <span class="kbd"><kbd>↩</kbd>editar</span>
          <span class="kbd"><kbd>⇥</kbd>siguiente</span>
          <span class="kbd"><kbd>⌥</kbd><kbd>↩</kbd>salto de línea</span>
          <span class="kbd"><kbd>⎋</kbd>cancelar</span>
          <span class="kbd"><kbd>⌘</kbd><kbd>F</kbd>buscar</span>
          <span class="kbd"><kbd>⌘</kbd><kbd>Z</kbd>deshacer</span>
        </div>
      </article>

      <article class="card span-2 reveal">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-15-6.7L3 13"/></svg></div>
        <h3>Deshacer infinito</h3>
        <p>Cada edición, fila, columna u ordenamiento se puede deshacer y rehacer, incluso sobre un millón de filas.</p>
        <div class="undo-stack" id="undo">
          <div>Ordenar «importe» <span>⌘Z</span></div>
          <div>Insertar columna <span>⌘Z</span></div>
          <div>Editar B12 <span>⌘Z</span></div>
        </div>
      </article>

      <article class="card span-2 reveal d1">
        <div class="ico o"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></div>
        <h3>Habla con Excel y Numbers</h3>
        <p>Copia y pega rangos en ambos sentidos. Pegar fuera de la tabla la amplía sola. Guarda con el preset «Excel» y se abre perfecto.</p>
      </article>

      <article class="card span-2 reveal d2">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
        <h3>Tus datos no salen de tu Mac</h3>
        <p>Sin cuentas, sin nube, sin telemetría. App con sandbox, firmada con Developer ID y notarizada por Apple.</p>
      </article>

      <article class="card span-6 reveal">
        <div class="ico o"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10"/></svg></div>
        <h3>Todo lo que esperas de un editor serio</h3>
        <p>Y nada que no necesites. Sin fórmulas, sin hojas múltiples, sin colores: solo tus datos, limpios y rápidos.</p>
        <div class="pill-row">
          <span class="pill">Buscar y reemplazar</span><span class="pill">Filtrar filas que coinciden</span><span class="pill">Ordenar texto o número</span>
          <span class="pill">Números alineados a la derecha</span><span class="pill">Insertar / eliminar filas y columnas</span><span class="pill">Mover columnas</span>
          <span class="pill">Autoajustar ancho</span><span class="pill">Encabezado en un clic</span><span class="pill">Celdas multilínea</span>
          <span class="pill">Autoguardado y versiones</span><span class="pill">Modo tolerante con archivos rotos</span><span class="pill">Español e inglés</span>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ================= FIDELITY ================= -->
<section id="fidelidad">
  <div class="wrap">
    <span class="eyebrow reveal">Fidelidad</span>
    <h2 class="title reveal d1">El mismo archivo. <span class="grad">Dos destinos.</span></h2>
    <p class="lead reveal d2">Una sola fila de un CSV cualquiera. Mira qué pasa cuando la abres y la guardas sin tocar nada.</p>

    <div class="raw reveal d2" id="raw"><span class="c">ventas.csv →</span> 00123<span class="sep">;</span>2026-03-04<span class="sep">;</span>1,50<span class="sep">;</span>+5215512345678<span class="sep">;</span>1E5<span class="sep">;</span>MARCH1</div>

    <div class="versus">
      <div class="vs-card bad reveal">
        <div class="vs-head">Hoja de cálculo típica <span class="tag">datos alterados</span></div>
        <div class="vs-rows" id="badrows"></div>
      </div>
      <div class="vs-card good reveal d1">
        <div class="vs-head"><span style="display:flex;align-items:center;gap:10px"><img src="assets/icon.png" alt="" style="width:24px">iCSV</span> <span class="tag">idéntico</span></div>
        <div class="vs-rows" id="goodrows"></div>
      </div>
    </div>
  </div>
</section>

<!-- ================= PERFORMANCE ================= -->
<section id="rendimiento">
  <div class="wrap">
    <span class="eyebrow reveal">Rendimiento</span>
    <h2 class="title reveal d1">Presupuestos, <span class="grad">no promesas.</span></h2>
    <p class="lead reveal d2">Cada ruta caliente se mide antes y después de cada cambio. Ninguna versión puede ser más de un 5 % más lenta que la anterior. Estos son los límites que la app tiene prohibido cruzar:</p>

    <div class="bento" style="margin-top:50px">
      <article class="card span-2 reveal"><div class="stat" style="background:none;padding:0"><div class="n">&lt;0,5<small>s</small></div><p>para abrir 100 MB (≈ 1 M filas × 20 columnas) y ver datos.</p></div></article>
      <article class="card span-2 reveal d1"><div class="stat" style="background:none;padding:0"><div class="n">&lt;8<small>ms</small></div><p>para editar una celda. Menos que un frame a 120 Hz.</p></div></article>
      <article class="card span-2 reveal d2"><div class="stat" style="background:none;padding:0"><div class="n">0<small>hitches</small></div><p>al hacer scroll en cualquier dirección, a 120 Hz.</p></div></article>
      <article class="card span-2 reveal"><div class="stat" style="background:none;padding:0"><div class="n">&lt;1<small>s</small></div><p>para ordenar un millón de filas, sin bloquear la interfaz.</p></div></article>
      <article class="card span-2 reveal d1"><div class="stat" style="background:none;padding:0"><div class="n">&lt;300<small>ms</small></div><p>para buscar en un archivo de 100 MB.</p></div></article>
      <article class="card span-2 reveal d2"><div class="stat" style="background:none;padding:0"><div class="n">≈4<small>B/campo</small></div><p>de memoria extra: el índice guarda posiciones, no copias de texto.</p></div></article>
    </div>
  </div>
</section>

<!-- ================= STEPS ================= -->
<section>
  <div class="wrap">
    <span class="eyebrow reveal">Empieza en 30 segundos</span>
    <h2 class="title reveal d1">Tres pasos. <span class="grad">Cero asistentes.</span></h2>
    <div class="steps">
      <div class="step reveal"><h3>Descarga</h3><p>Un DMG de 2,5 MB, firmado y notarizado. Universal para Apple Silicon e Intel.</p></div>
      <div class="step reveal d1"><h3>Arrastra a Aplicaciones</h3><p>Como cualquier app de Mac. Sin instaladores, sin cuentas, sin permisos raros.</p></div>
      <div class="step reveal d2"><h3>Abre cualquier CSV</h3><p>Doble clic, arrastrar al Dock o ⌘O. iCSV detecta el formato y te muestra la tabla al instante.</p></div>
    </div>
  </div>
</section>

<!-- ================= FAQ ================= -->
<section id="faq">
  <div class="wrap">
    <span class="eyebrow reveal">Preguntas frecuentes</span>
    <h2 class="title reveal d1">Lo que quizá te preguntas.</h2>
    <div class="faq">
      <details class="reveal"><summary>¿Qué formatos puedo abrir?</summary><p>CSV, TSV, PSV, DSV y en general cualquier texto delimitado: coma, punto y coma, tabulador, barra vertical, dos puntos, <code>^</code>, <code>~</code>, espacio o cualquier carácter ASCII. Entiende comillas dobles o simples, escapes estilo RFC 4180 (<code>""</code>) o MySQL (<code>\"</code>), y la línea <code>sep=</code> de Excel.</p></details>
      <details class="reveal"><summary>¿Y las codificaciones raras de Windows?</summary><p>UTF-8 con o sin BOM, UTF-16 LE/BE (la exportación «Unicode» de Excel), UTF-32 con BOM, Windows-1252, ISO-8859-1 y Mac Roman se detectan automáticamente. Si necesitas otra, puedes reinterpretar el archivo desde el popover de formato.</p></details>
      <details class="reveal"><summary>¿Qué pasa si el archivo está mal formado?</summary><p>iCSV nunca lo rechaza. Entra en modo tolerante: una comilla en medio de un campo se toma como literal, y si una comilla nunca se cierra se reinterpreta desde esa línea. Verás un aviso con el número de línea exacto.</p></details>
      <details class="reveal"><summary>¿Cambia mis números o fechas como Excel?</summary><p>Jamás. Una celda es texto y se guarda tal cual. <code>00123</code> sigue siendo <code>00123</code>, <code>2026-03-04</code> no se convierte en otra fecha y <code>1E5</code> no se vuelve 100000. Lo que no editas sale byte a byte idéntico.</p></details>
      <details class="reveal"><summary>¿Qué requisitos tiene?</summary><p>macOS 26 o posterior, en cualquier Mac con Apple Silicon o Intel. Ocupa unos pocos megas y no necesita conexión a internet.</p></details>
      <details class="reveal"><summary>¿Por qué macOS dice que la descargué de internet?</summary><p>Es el aviso normal de Gatekeeper para cualquier app fuera del App Store. iCSV está firmada con Developer ID y notarizada por Apple, así que se abre sin advertencias de seguridad.</p></details>
    </div>
  </div>
</section>

<!-- ================= FINAL CTA ================= -->
<section class="final" id="descargar">
  <div class="wrap">
    <div class="final-box reveal">
      <span class="ring"></span><span class="ring" style="animation-delay:-2s"></span><span class="ring" style="animation-delay:-4s"></span>
      <img src="assets/icon.png" alt="">
      <h2>Deja de esperar<br>a tus <span class="grad">datos.</span></h2>
      <p class="lead">Descarga iCSV y abre ese archivo que tu hoja de cálculo no se atreve a abrir.</p>
      <div class="cta-row">
        <a href={dl} download class="btn btn-primary btn-big magnetic js-download">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 5-5m-5 5-5-5M4 21h16"/></svg>
          Descargar iCSV 1.0
        </a>
      </div>
      <div class="meta"><span>iCSV-1.0.dmg · 2,5 MB</span><span>Universal</span><span>macOS 26+</span></div>
      <div class="checksum" id="checksum" data-sha={sha} title="Copiar SHA-256">SHA-256 · {sha}</div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <a href="#" class="brand"><img src="assets/icon.png" alt="" style="width:24px;height:24px"> iCSV</a>
    <span>© 2026 Erwin · Hecho en Swift con ❤️ para Mac · <a href="/contacto/?app=icsv">¿Problemas? Escríbeme</a></span>
  </div>
</footer>

<script>import '../../scripts/pages/icsv';</script>
</AppPage>
